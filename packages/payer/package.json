{
  "name": "@subetha/payer",
  "version": "0.2.0",
  "description": "Local payer for the SubEtha Router: holds your keys (EVM and Solana), confirms every payment with you, and talks to the hosted Router for an AI agent (stdio MCP) and for you (CLI). Every inbound rail and dynamic provider URL the Router offers. Testnets only.",
  "homepage": "https://subethalabs.com/router/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subetha-labs/subetha-router.git",
    "directory": "packages/payer"
  },
  "bugs": {
    "url": "https://github.com/subetha-labs/subetha-router/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "subetha-payer": "bin/subetha-payer"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "dist",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "vendor": "node --import tsx scripts/vendor.ts",
    "build": "../../node_modules/.bin/tsc -p tsconfig.build.json",
    "types": "../../node_modules/.bin/tsc --noEmit -p tsconfig.json",
    "test": "../../node_modules/.bin/vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@solana-program/compute-budget": "0.19.0",
    "@solana-program/token": "0.17.0",
    "@solana/kit": "8.4.0",
    "mppx": "0.11.0",
    "undici": "8.11.2",
    "viem": "2.54.2",
    "zod": "3.25.76"
  }
}

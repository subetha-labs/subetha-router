# Verification aid (not part of the policy): the host-side observer. It binds @PORT@ before it
# advertises anything, records every accepted TCP connection and every received line with a
# sequence number, and serves them as JSON on @REPORT@ (loopback use by the runner). "Started"
# only after the report says listening=true (ExecStartPost), so Before=docker.service means the
# observed socket is open before any container is restored. Placeholders are substituted by
# `subetha-egress-verify --reboot-prepare`.
[Unit]
Description=egress verification: host-side observer
Before=docker.service

[Service]
ExecStart=@PYTHON3@ @UNIT_DIR@/egress-observer.py --port @PORT@ --report-port @REPORT@
ExecStartPost=/bin/sh -c 'i=0; while [ $i -lt 50 ]; do curl -sf -m 1 -o /dev/null http://127.0.0.1:@REPORT@/health && exit 0; i=$((i+1)); sleep 0.2; done; exit 1'
StandardOutput=append:/var/tmp/host-observer.log
StandardError=append:/var/tmp/host-observer.log

[Install]
WantedBy=multi-user.target

  dnat_path INPUT "$(gateway_ip):$OBS_PORT" "$(gateway_ip)" hobs_accepts 18001
  dnat_path FORWARD "$OBSERVER" "$(deny_line_of "${OBSERVER%%:*}")" xobs_accepts 18002
  echo "-- V5-6 adjacency (temporary adversarial topology; expectation depends on bridge-nf-call-iptables)"
  local nf; nf=$(cat /proc/sys/net/bridge/bridge-nf-call-iptables 2>/dev/null || echo absent)
  r=$(curlx "http://$T:8000/" 2)
  if [ "$nf" = 1 ]; then [ "${r%% *}" = 28 ] && ok V5-6 "same-bridge neighbor $T firewall-dropped (bridge-nf-call-iptables=1)" || ng V5-6 "same-bridge neighbor $T: '$r' with bridge-nf-call-iptables=1"
  else [ "${r#* }" = 200 ] && ok V5-6 "same-bridge neighbor $T REACHABLE (bridge-nf-call-iptables=$nf): L2-bridged traffic bypasses the rules, which is why the singleton topology is mandatory" || ng V5-6 "same-bridge neighbor $T: '$r' (bridge-nf-call-iptables=$nf)"; fi
  docker rm -f egress-verify-target >/dev/null 2>&1
  docker run -d --name egress-verify-target "$PY_IMAGE" python3 -m http.server 8000 --bind 0.0.0.0 --directory /tmp >/dev/null 2>&1; sleep 2
  T=$(docker inspect egress-verify-target --format '{{(index .NetworkSettings.Networks "bridge").IPAddress}}')
  local raw0 raw1; rawcnt() { iptables -t raw -L PREROUTING -n -v -x 2>/dev/null | awk -v n="$1" '$9==n {s+=$1} END{print s+0}'; }
  c0=$(cnt '172.16.0.0/12'); raw0=$(rawcnt "$T"); r=$(curlx "http://$T:8000/" 2); c1=$(cnt '172.16.0.0/12'); raw1=$(rawcnt "$T")
  if [ "${r%% *}" = 28 ] && [ "$c1" -gt "$c0" ]; then ok V5-6 "docker0 neighbor $T firewall-dropped by our chain (+$((c1-c0)))"
  elif [ "${r%% *}" = 28 ] && [ "$raw1" -gt "$raw0" ]; then ok V5-6 "docker0 neighbor $T dropped by Docker's own raw PREROUTING rule (+$((raw1-raw0))) before our chain: not delivered, but not our evidence"
  else ng V5-6 "docker0 neighbor $T: '$r' (ours +$((c1-c0)), docker raw +$((raw1-raw0)))"; fi
  docker rm -f egress-verify-target >/dev/null 2>&1
  ip addr del $A/32 dev "$UPLINK" 2>/dev/null; "$SCRIPT" apply >/dev/null
  echo "-- V5-9 pre-existing flow to the host observer (allowed while the policy is removed, cut by apply)"
  FORCE=1 "$SCRIPT" remove; docker rm -f egress-verify-stream >/dev/null 2>&1; sleep 0.5; t0=$(now)
  docker run -d --name egress-verify-stream --network "container:$NS" "$ALPINE_IMAGE" sh -c "i=0; while true; do i=\$((i+1)); echo tick \$i; sleep 1; done | nc $(gateway_ip) $OBS_PORT" >/dev/null 2>&1
  sleep 3.5; local before after ta; before=$(hobs_lines "$t0" tick); "$SCRIPT" apply >/dev/null; ta=$(now); sleep 4; after=$(hobs_lines "$ta" tick)
  local ct; ct=$(conntrack -L 2>/dev/null | grep "src=$rip " | grep -c "dport=$OBS_PORT ")
  docker rm -f egress-verify-stream >/dev/null 2>&1
  [ "$before" -ge 2 ] && [ "$after" = 0 ] && ok V5-9 "existing flow: $before ticks arrived before apply, 0 after (conntrack entry still present: $ct) -- ORIGINAL-direction packets are dropped" || ng V5-9 "existing flow: ticks before=$before after=$after"
  hobs_stop
  echo "-- V5-13 guard recovery (best effort; the policy is absent until the timer fires)"
  guard_resume; iptables -t mangle -F SUBETHA-EGRESS; local tg; tg=$(date +%s)
  while ! "$SCRIPT" check >/dev/null 2>&1; do sleep 2; [ $(( $(date +%s) - tg )) -gt 90 ] && break; done
  "$SCRIPT" check >/dev/null 2>&1 && ok V5-13 "guard restored the full policy $(( $(date +%s) - tg )) s after a flush (recovery, not a bound)" || { ng V5-13 "guard did not restore within 90 s"; "$SCRIPT" apply >/dev/null; }
  docker rm -f egress-verify-standin >/dev/null 2>&1; NS=$ROUTER
  "$SCRIPT" check >/dev/null 2>&1 && ok V5-17 "final policy check after cleanup" || ng V5-17 "policy does not verify after cleanup"
}
controls_ns_only() { # the DNS and public-control items against the current namespace (used for the stand-in)
  echo "== V5-7/8 (stand-in) =="
  local r; r=$(curlx "https://example.com/" 6); [ "${r%% *}" = 0 ] && ok V5-7 "stand-in -> public HTTPS: ${r#* }" || ng V5-7 "stand-in -> public HTTPS: '$r'"
  local V; V=$(veth_of "$NS") || return
  capture_start "$V" "port 53" /var/tmp/ev-dns2.pcap || { ng V5-8 "DNS capture not ready"; return; }
  local name="v$(date +%s%N | cut -c1-13).1.1.1.1.nip.io"; r=$(probe "curl -s -o /dev/null -m 5 -w '%{exitcode} %{remote_ip}' http://$name/"); capture_stop /var/tmp/ev-dns2.pcap
  [ "${r#* }" = 1.1.1.1 ] && [ "$(pkts /var/tmp/ev-dns2.pcap)" = 0 ] && ok V5-8 "stand-in: uncached name resolved with 0 DNS packets on its veth" || ng V5-8 "stand-in DNS: '$r', veth DNS packets $(pkts /var/tmp/ev-dns2.pcap)"
}
dnat_path() { # $1 hook, $2 target ip:port, $3 counter line, $4 accept-count fn, $5 alias port
  local hook=$1 target=$2 line=$3 countfn=$4 port=$5 A=11.22.33.44 c0 c1 r t0
  [ -n "$line" ] || { ng V5-5 "$hook path: target $target is not inside a denied range; choose an RFC1918 observer"; return; }
  sab iptables -t nat -I PREROUTING 1 -i "$BRIDGE" -d $A/32 -p tcp --dport "$port" -j DNAT --to-destination "$target" || return
  iptables -t mangle -D SUBETHA-EGRESS -d $A/32 -j DROP 2>/dev/null
  c0=$(cnt "$line"); t0=$(now); r=$(curlx "http://$A:$port/" 2); c1=$(cnt "$line")
  [ "${r%% *}" = 28 ] && [ "$c1" -gt "$c0" ] && [ "$($countfn "$t0")" = 0 ] && ok V5-5 "DNAT $A:$port -> $target: post-DNAT destination firewall-dropped in $hook (+$((c1-c0)) on $line, 0 accepts at the target)" || ng V5-5 "$hook path with re-check: '$r' $c0->$c1 accepts=$($countfn "$t0")"
  iptables -t mangle -D "$hook" -i "$BRIDGE" -j SUBETHA-EGRESS
  t0=$(now); r=$(curlx "http://$A:$port/" 3)
  [ "${r%% *}" = 0 ] && [ "$($countfn "$t0")" -ge 1 ] && ok V5-5 "positive control: without the $hook jump the translated connection reaches $target (http ${r#* }, $($countfn "$t0") accept recorded at the target)" || ng V5-5 "positive control on $hook: '$r' accepts=$($countfn "$t0")"
  iptables -t nat -D PREROUTING -i "$BRIDGE" -d $A/32 -p tcp --dport "$port" -j DNAT --to-destination "$target"
  "$SCRIPT" apply >/dev/null || ng V5-5 "apply failed after the $hook DNAT test"
}

fail_closed() {
  echo "== V5-12 fail-closed (stops Docker; observed through the restart retries in the journal) =="
  cp "$ENV_FILE" /var/tmp/egress-verify-env.bak
  systemctl stop docker.socket docker.service
  local t0; t0=$(date -u +%Y-%m-%dT%H:%M:%S)
  printf 'IFACES="%s"\nHOST_ADDRS4="not-an-address"\n' "$(env_value IFACES)" > "$ENV_FILE"
  systemctl start docker.service >/dev/null 2>&1; sleep 20
  local retries cause; retries=$(TZ=UTC journalctl -q -S "$t0" -u docker.service -o cat | grep -c 'Scheduled restart job\|Failed with result'); cause=$(TZ=UTC journalctl -q -S "$t0" -u docker.service -o cat | grep -m1 'subetha-egress:')
  [ "$(pgrep -c dockerd)" -eq 0 ] && [ "$(pgrep -c containerd-shim)" -eq 0 ] && [ "$retries" -ge 2 ] && ok V5-12 "bad HOST_ADDRS4: 0 dockerd and 0 container shims after 20 s; journal shows $retries failure/restart events; cause: $cause" || ng V5-12 "dockerd=$(pgrep -c dockerd) shims=$(pgrep -c containerd-shim) retries=$retries cause='$cause'"
  printf 'TYPO_KEY=1\n' >> "$ENV_FILE"; systemctl reset-failed docker.service; t0=$(date -u +%Y-%m-%dT%H:%M:%S); systemctl start docker.service >/dev/null 2>&1; sleep 10
  [ "$(pgrep -c dockerd)" -eq 0 ] && ok V5-12 "unknown key: docker.service failed ($(TZ=UTC journalctl -q -S "$t0" -u docker.service -o cat | grep -m1 'unknown key'))" || ng V5-12 "docker started despite an unknown key"
  cp /var/tmp/egress-verify-env.bak "$ENV_FILE"; systemctl reset-failed docker.service; systemctl start docker.service; sleep 8
  docker start "$ROUTER" >/dev/null 2>&1   # a production Router restores itself (--restart unless-stopped)
  "$SCRIPT" guard >/dev/null 2>&1          # refresh the inventory (bridge addresses appear after dockerd starts)
  "$SCRIPT" check >/dev/null 2>&1 && [ "$(docker inspect "$ROUTER" --format '{{.State.Running}}' 2>/dev/null)" = true ] && ok V5-12 "restored: docker up, policy verified, $ROUTER running" || ng V5-12 "restore failed: check Docker and $ROUTER"
}

reboot_prepare() {

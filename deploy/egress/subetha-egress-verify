#!/bin/bash
# subetha-egress-verify: run the acceptance protocol of docs/ssrf-egress-design.md §15.6 on the
# host and print evidence for every item. Exit status is non-zero if any item fails. Every
# required observation is a gate: instrumentation that fails to start fails the item.
#
#   sudo subetha-egress-verify                  non-disruptive items + preconditions (Router running)
#   sudo subetha-egress-verify --adversarial    Router STOPPED: a stand-in container on the Router's
#                                               network takes its place; temporary host alias and
#                                               containers, policy removal/re-apply, sabotage of `check`,
#                                               both DNAT paths, guard recovery. Requires OBSERVER.
#   sudo subetha-egress-verify --fail-closed    stops Docker, breaks the env file, proves Docker stays
#                                               down through its restart retries (journal), restores.
#   sudo subetha-egress-verify --reboot-prepare installs the probe container and the boot-ordered
#                                               observer units (plus a test-only docker drop-in). Requires
#                                               OBSERVER. Then reboot.
#   sudo subetha-egress-verify --post-boot      reads the boot-ordered evidence after the reboot.
#   sudo subetha-egress-verify --reboot-cleanup removes the probe container, observers and the drop-in.
#
# Environment: ROUTER (container, default subetha-router), NET (default subetha-router-net), BRIDGE
# (default subetha0), UPLINK (default: default-route interface), HEALTH_URL (default
# http://127.0.0.1:8787/healthz; must be the same URL inside and outside the container),
# OBSERVER=<rfc1918 ip>:<port> and OBSERVER_REPORT=<ip>:<port>: an external host you control running
# deploy/egress/egress-observer.py (--port / --report-port). The host-side observer is started by
# this runner (standard/adversarial) or by egress-host-observer.service (reboot).
set -u
ROUTER=${ROUTER:-subetha-router}; NET=${NET:-subetha-router-net}; BRIDGE=${BRIDGE:-subetha0}
UPLINK=${UPLINK:-$(ip -4 route show default | awk '{print $5; exit}')}
HEALTH_URL=${HEALTH_URL:-http://127.0.0.1:8787/healthz}
OBSERVER=${OBSERVER:-}; OBSERVER_REPORT=${OBSERVER_REPORT:-}
ENV_FILE=${SUBETHA_EGRESS_ENV:-/etc/subetha-egress.env}
PROBE_IMAGE=${PROBE_IMAGE:-curlimages/curl:latest}; ALPINE_IMAGE=${ALPINE_IMAGE:-alpine:latest}; PY_IMAGE=${PY_IMAGE:-python:3-alpine}
SCRIPT=${SCRIPT:-/usr/local/sbin/subetha-egress}
UNIT_DIR=${UNIT_DIR:-/usr/local/lib/subetha-egress}
OBS_PORT=19998; OBS_REPORT=19997        # host-side observer ports
REGISTRY_DATE=2025-10-09; CAPTURE_SECONDS=${CAPTURE_SECONDS:-900}
MODE=standard
for a in "$@"; do case "$a" in
  --adversarial) MODE=adversarial ;; --fail-closed) MODE=fail-closed ;; --reboot-prepare) MODE=reboot-prepare ;;
  --post-boot) MODE=post-boot ;; --reboot-cleanup) MODE=reboot-cleanup ;;
  *) echo "unknown option $a" >&2; exit 64 ;; esac; done

pass=0; fail=0; info=0
ok()   { pass=$((pass+1)); printf 'PASS %-6s %s\n' "$1" "$2"; }
ng()   { fail=$((fail+1)); printf 'FAIL %-6s %s\n' "$1" "$2"; }
note() { info=$((info+1)); printf 'INFO %-6s %s\n' "$1" "$2"; }
need() { command -v "$1" >/dev/null 2>&1 || { echo "missing tool: $1" >&2; exit 69; }; }
for t in docker iptables ip6tables tcpdump conntrack curl python3 ip awk flock; do need "$t"; done
[ -r "$UNIT_DIR/egress-observer.py" ] || { echo "missing $UNIT_DIR/egress-observer.py" >&2; exit 69; }

# NS is the container whose network namespace the probes join: the Router (standard) or the
# stand-in (adversarial, with the Router stopped).
NS=$ROUTER
probe()  { docker run --rm --network "container:$NS" --entrypoint sh "$PROBE_IMAGE" -c "$1" 2>/dev/null; }
alp()    { docker run --rm --network "container:$NS" "$ALPINE_IMAGE" sh -c "$1" 2>/dev/null; }
curlx()  { probe "curl -s -o /dev/null -m ${2:-2} -w '%{exitcode} %{http_code}' '$1'"; }
veth_of(){ local idx; idx=$(docker exec "$1" cat /sys/class/net/eth0/iflink 2>/dev/null) || return 1
           ip -o link | awk -F': ' -v i="$idx" '$1==i{print $2}' | cut -d@ -f1; }
cnt()    { iptables -t mangle -L SUBETHA-EGRESS -n -v -x 2>/dev/null | awk -v n="${1%/32}" 'NR>2 && $9==n {print $1; exit}'; }
cnt_reply() { iptables -t mangle -L SUBETHA-EGRESS -n -v -x 2>/dev/null | awk 'NR==3 {print $1}'; }
ns_ip()  { docker inspect "$NS" --format "{{(index .NetworkSettings.Networks \"$NET\").IPAddress}}" 2>/dev/null; }
gateway_ip() { docker network inspect "$NET" --format '{{(index .IPAM.Config 0).Gateway}}' 2>/dev/null; }
subnet()  { docker network inspect "$NET" --format '{{(index .IPAM.Config 0).Subnet}}' 2>/dev/null; }
host_ip() { ip -4 -o addr show dev "$UPLINK" | awk '{print $4}' | cut -d/ -f1 | head -1; }
host_addrs4() { ip -4 -o addr show | awk '{print $4}' | cut -d/ -f1 | grep -v '^169\.254\.' | sort -u; }
env_value() { awk -F= -v k="$1" '$1==k{v=$2; gsub(/"/,"",v); print v}' "$ENV_FILE" 2>/dev/null; }
now()    { date +%s.%N; }
# ---- observers: host-side (started here) and external (OBSERVER / OBSERVER_REPORT)
hobs_start() { hobs_stop; : > /var/tmp/egress-verify-hobs.log
  nohup python3 "$UNIT_DIR/egress-observer.py" --port "$OBS_PORT" --report-port "$OBS_REPORT" >> /var/tmp/egress-verify-hobs.log 2>&1 &
  echo $! > /var/tmp/egress-verify-hobs.pid
  for i in $(seq 1 50); do curl -s -m 1 -o /dev/null "http://127.0.0.1:$OBS_REPORT/?since=0" && return 0; sleep 0.2; done
  echo "host observer did not become ready" >&2; return 1; }
hobs_stop() { [ -f /var/tmp/egress-verify-hobs.pid ] && { kill "$(cat /var/tmp/egress-verify-hobs.pid)" 2>/dev/null; rm -f /var/tmp/egress-verify-hobs.pid; }; return 0; }
# accepts recorded by an observer report endpoint since $2 (unix time), optionally only rows whose data matches $3
obs_count() { local url=$1 since=$2 pat=${3:-}
  curl -s -m 5 "http://$url/?since=$since" 2>/dev/null | python3 -c '
import json,sys
pat=sys.argv[1]; kind=sys.argv[2]
try: rows=json.load(sys.stdin)
except Exception: print("ERR"); sys.exit(0)
print(sum(1 for r in rows if r["kind"]==kind and (not pat or pat in r.get("data",""))))' "$pat" "${4:-accept}"; }
hobs_accepts() { obs_count "127.0.0.1:$OBS_REPORT" "$1" "" accept; }
hobs_lines()   { obs_count "127.0.0.1:$OBS_REPORT" "$1" "${2:-}" line; }
xobs_accepts() { obs_count "$OBSERVER_REPORT" "$1" "" accept; }
xobs_lines()   { obs_count "$OBSERVER_REPORT" "$1" "${2:-}" line; }
# ---- captures: readiness is mandatory, unreadable captures are errors
capture_start() { rm -f "$3"; tcpdump -Z root -i "$1" -w "$3" -U "$2" >/dev/null 2>"$3.err" & echo $! > "$3.pid"
  for i in $(seq 1 30); do grep -q 'listening on' "$3.err" 2>/dev/null && return 0; sleep 0.1; done; echo "capture on $1 not ready" >&2; return 1; }
capture_stop() { kill -INT "$(cat "$1.pid")" 2>/dev/null; wait "$(cat "$1.pid")" 2>/dev/null; rm -f "$1.pid"; sleep 1; }
pkts()   { [ -s "$1" ] || { echo ERR; return; }; local o; o=$(tcpdump -nn -r "$1" ${2:+"$2"} 2>/dev/null) || { echo ERR; return; }; printf '%s' "$o" | grep -c .; }
isnum()  { [ "$1" -ge 0 ] 2>/dev/null; }
guard_pause()  { systemctl stop subetha-egress-guard.timer 2>/dev/null; }
guard_resume() { systemctl start subetha-egress-guard.timer 2>/dev/null; }
require_observer() { [ -n "$OBSERVER" ] && [ -n "$OBSERVER_REPORT" ] || { echo "OBSERVER=<rfc1918 ip:port> and OBSERVER_REPORT=<ip:port> (egress-observer.py on a host you control) are required for this mode" >&2; exit 64; }
  [ "$(obs_count "$OBSERVER_REPORT" 0 "" accept)" != ERR ] || { echo "external observer report endpoint $OBSERVER_REPORT not reachable from the host" >&2; exit 69; }; }

DENY_FILTER='(dst net 0.0.0.0/8 or dst net 10.0.0.0/8 or dst net 100.64.0.0/10 or dst net 127.0.0.0/8 or dst net 169.254.0.0/16 or dst net 172.16.0.0/12 or dst net 192.0.0.0/24 or dst net 192.0.2.0/24 or dst net 192.88.99.0/24 or dst net 192.168.0.0/16 or dst net 198.18.0.0/15 or dst net 198.51.100.0/24 or dst net 203.0.113.0/24 or dst net 224.0.0.0/4 or dst net 240.0.0.0/4)'
SRC_FILTER='(src net 0.0.0.0/8 or src net 10.0.0.0/8 or src net 100.64.0.0/10 or src net 127.0.0.0/8 or src net 169.254.0.0/16 or src net 172.16.0.0/12 or src net 192.0.0.0/24 or src net 192.0.2.0/24 or src net 192.88.99.0/24 or src net 192.168.0.0/16 or src net 198.18.0.0/15 or src net 198.51.100.0/24 or src net 203.0.113.0/24 or src net 224.0.0.0/4 or src net 240.0.0.0/4)'
MATRIX_RE='dst=(0\.1\.2\.3|10\.0\.0\.1|100\.64\.0\.1|169\.254\.169\.254|172\.16\.0\.1|192\.0\.0\.1|192\.0\.2\.1|192\.88\.99\.1|192\.168\.0\.1|198\.18\.0\.1|198\.51\.100\.1|203\.0\.113\.1|240\.0\.0\.1) '
deny_line_of() { case "$1" in 10.*) echo 10.0.0.0/8 ;; 192.168.*) echo 192.168.0.0/16 ;; 172.1[6-9].*|172.2[0-9].*|172.3[01].*) echo 172.16.0.0/12 ;; 169.254.*) echo 169.254.0.0/16 ;; 100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*) echo 100.64.0.0/10 ;; *) echo "" ;; esac; }

# ---------------------------------------------------------------- preconditions / facts
dockerd_cmdline() { tr '\0' ' ' < "/proc/$(pidof dockerd | awk '{print $1}')/cmdline" 2>/dev/null; }
daemon_json() { local f; f=$(dockerd_cmdline | grep -o -- '--config-file[= ][^ ]*' | sed 's/--config-file[= ]//'); echo "${f:-/etc/docker/daemon.json}"; }
preconditions() {
  echo "== preconditions and facts (V5-0 / V5-15) =="
  "$SCRIPT" check >/dev/null 2>&1 && ok V5-0 "policy equals the rendered policy and the first rules of every hook are exactly our jumps (subetha-egress check)" || ng V5-0 "subetha-egress check failed: $("$SCRIPT" check 2>&1 | head -3 | tr '\n' ' ')"
  [ "$(docker inspect "$ROUTER" --format '{{.State.Running}}' 2>/dev/null)" = true ] && ok V5-0 "$ROUTER is running" || ng V5-0 "$ROUTER not running"
  local nets mode members
  nets=$(docker inspect "$ROUTER" --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}' 2>/dev/null)
  mode=$(docker inspect "$ROUTER" --format '{{.HostConfig.NetworkMode}}' 2>/dev/null)
  [ "$(echo $nets)" = "$NET" ] && [ "$mode" = "$NET" ] && ok V5-6 "complete attachment set is {$NET} (NetworkMode=$mode)" || ng V5-6 "attachment set '$nets' NetworkMode '$mode' (expected only $NET)"
  members=$(docker network inspect "$NET" --format '{{range .Containers}}{{.Name}} {{end}}' 2>/dev/null)
  [ "$(echo $members)" = "$ROUTER" ] && ok V5-6 "$NET contains only $ROUTER (singleton topology)" || ng V5-6 "$NET members: '$members' (expected only $ROUTER)"
  [ "$(docker network inspect "$NET" --format '{{index .Options "com.docker.network.bridge.name"}}')" = "$BRIDGE" ] && ok V5-0 "bridge name is $BRIDGE" || ng V5-0 "bridge name is not $BRIDGE"
  echo " $(env_value IFACES) " | grep -q " $BRIDGE " && ok V5-0 "IFACES covers $BRIDGE" || ng V5-0 "IFACES '$(env_value IFACES)' does not list $BRIDGE"
  [ -n "$(deny_line_of "$(gateway_ip)")" ] && ok V5-0 "$NET subnet $(subnet) lies inside a denied range ($(deny_line_of "$(gateway_ip)")): the gateway is covered before the first guard pass" || ng V5-0 "$NET subnet $(subnet) is not inside RFC1918/CGNAT: its gateway would be reachable until the first inventory refresh"
  [ "$(docker network inspect "$NET" --format '{{.EnableIPv6}}')" = false ] && ok V5-14 "$NET has IPv6 disabled" || ng V5-14 "$NET has IPv6 enabled: IPv6 enforcement is not covered by this runner"
  [ "$(docker info --format '{{.LiveRestoreEnabled}}')" = false ] && ok V5-15 "LiveRestoreEnabled=false (docker info)" || ng V5-15 "LiveRestoreEnabled=true: containers survive daemon stop; fail-closed does not hold"
  if [ "$(systemctl is-active firewalld 2>/dev/null)" = active ]; then ng V5-15 "firewalld is active (reloads flush mangle; disable it)"
  else case "$(systemctl is-enabled firewalld 2>&1 | head -1)" in enabled|static) ng V5-15 "firewalld is enabled" ;; *) ok V5-15 "firewalld absent, disabled and inactive" ;; esac; fi
  local dj; dj=$(daemon_json)
  if dockerd_cmdline | grep -q -- '--userland-proxy=false' || grep -q '"userland-proxy": *false' "$dj" 2>/dev/null; then ng V5-15 "userland-proxy=false (cmdline or $dj): hairpin uses DNAT, a path this runner does not validate"; else ok V5-15 "userland-proxy default (effective: cmdline and $dj)"; fi
  [ "$(systemctl show docker.service -p ExecStartPre --value | grep -c 'argv\[\]=/usr/local/sbin/subetha-egress apply ')" -ge 1 ] && ok V5-15 "docker.service ExecStartPre runs exactly 'subetha-egress apply'" || ng V5-15 "docker.service ExecStartPre does not run 'subetha-egress apply': $(systemctl show docker.service -p ExecStartPre --value | head -c 160)"
  [ "$(systemctl is-active subetha-egress-guard.timer)" = active ] && ok V5-15 "guard timer active" || ng V5-15 "guard timer not active"
  note V5-15 "kernel $(uname -r); docker $(docker version --format '{{.Server.Version}}') (DNS provenance measured on 28.3.3; V5-8 re-measures here); backend $(docker info --format '{{.FirewallBackend.Driver}}' 2>/dev/null || docker info --format '{{.FirewallBackend}}'); $(iptables -V); bridge-nf-call-iptables=$(cat /proc/sys/net/bridge/bridge-nf-call-iptables 2>/dev/null || echo absent)"
  note V5-15 "docker raw rules: $(iptables -t raw -S 2>/dev/null | grep -c -- '^-A'); nat DOCKER returns for bridges: $(iptables -t nat -S DOCKER 2>/dev/null | grep -c -- '-j RETURN'); docker mangle rules: $(iptables -t mangle -S 2>/dev/null | grep -v SUBETHA | grep -c -- '^-A')"
  local upd; upd=$(curl -s -m 10 https://www.iana.org/assignments/iana-ipv6-special-registry/iana-ipv6-special-registry.xml | grep -o '<updated>[^<]*</updated>' | head -1 | sed 's/<[^>]*>//g')
  if [ -z "$upd" ]; then ng V5-15 "IANA registry date not fetched: cannot confirm the snapshot is current"; elif [ "$upd" \> "$REGISTRY_DATE" ]; then ng V5-15 "IANA IPv6 registry updated $upd > snapshot $REGISTRY_DATE: review DENY6"; else ok V5-15 "IANA registry snapshot $REGISTRY_DATE is current ($upd)"; fi
  # DNS provenance: no override anywhere (container, daemon.json, dockerd command line), embedded resolver in use
  [ "$(docker inspect "$ROUTER" --format '{{len .HostConfig.Dns}}{{len .HostConfig.DnsOptions}}{{len .HostConfig.DnsSearch}}')" = 000 ] && ok V5-8 "$ROUTER has no --dns/--dns-opt/--dns-search override" || ng V5-8 "$ROUTER overrides DNS (HostConfig.Dns*): the embedded resolver would forward from the container namespace"
  if grep -q '"dns"' "$dj" 2>/dev/null || dockerd_cmdline | grep -q -- '--dns[= ]'; then ng V5-8 "daemon sets dns ($dj or cmdline): the embedded resolver would forward from the container namespace"; else ok V5-8 "no daemon dns override ($dj, cmdline)"; fi
  local resolv; resolv=$(docker exec "$ROUTER" cat /etc/resolv.conf 2>/dev/null | awk '/^nameserver/{print $2; exit}')
  [ "$resolv" = 127.0.0.11 ] && ok V5-8 "container resolver is the embedded DNS (127.0.0.11)" || ng V5-8 "container resolver is $resolv, not the embedded DNS"
  note V5-8 "host nameservers (inherited by the embedded resolver): $(awk '/^nameserver/{print $2}' /etc/resolv.conf | tr '\n' ' ')"
}

# ---------------------------------------------------------------- matrix
matrix() {
  echo "== V5-1 matrix from the namespace of $NS (TCP; UDP; ICMP; captures both ways) =="
  local V; V=$(veth_of "$NS") || { ng V5-1 "cannot find the veth of $NS"; return; }
  capture_start "$UPLINK" "$DENY_FILTER" /var/tmp/ev-uplink.pcap || { ng V5-1 "uplink capture not ready"; return; }
  capture_start "$V" "(src net $(subnet) and $DENY_FILTER) or (dst net $(subnet) and $SRC_FILTER)" /var/tmp/ev-veth.pcap || { ng V5-1 "veth capture not ready"; capture_stop /var/tmp/ev-uplink.pcap; return; }
  for t in 0.1.2.3:0.0.0.0/8 10.0.0.1:10.0.0.0/8 100.64.0.1:100.64.0.0/10 169.254.169.254:169.254.0.0/16 172.16.0.1:172.16.0.0/12 192.0.0.1:192.0.0.0/24 192.0.2.1:192.0.2.0/24 192.88.99.1:192.88.99.0/24 192.168.0.1:192.168.0.0/16 198.18.0.1:198.18.0.0/15 198.51.100.1:198.51.100.0/24 203.0.113.1:203.0.113.0/24 240.0.0.1:240.0.0.0/4; do
    local ip=${t%%:*} range=${t#*:} c0 c1 r
    c0=$(cnt "$range"); r=$(curlx "http://$ip:80/" 2); c1=$(cnt "$range")
    if [ "${r%% *}" = 28 ] && [ "$c1" -gt "$c0" ]; then ok V5-1 "$ip TCP firewall-dropped (curl 28, $range +$((c1-c0)))"; else ng V5-1 "$ip: curl '$r', counter $c0->$c1"; fi
  done
  local c0 c1 r
  c0=$(cnt '224.0.0.0/4'); r=$(curlx "http://224.0.0.1:80/" 2); c1=$(cnt '224.0.0.0/4')
  [ "${r%% *}" = 7 ] && [ "$c1" -eq "$c0" ] && ok V5-1 "224.0.0.1 TCP kernel-rejected (curl 7, nothing sent)" || ng V5-1 "224.0.0.1 TCP: curl '$r', counter $c0->$c1"
  c0=$(cnt '224.0.0.0/4'); alp "echo x | nc -u -w 1 224.0.0.1 9" >/dev/null; c1=$(cnt '224.0.0.0/4')
  [ "$c1" -gt "$c0" ] && ok V5-1 "224.0.0.1 UDP firewall-dropped (+$((c1-c0)))" || ng V5-1 "224.0.0.1 UDP: counter $c0->$c1"
  c0=$(cnt '127.0.0.0/8'); r=$(curlx "http://127.1.2.3:80/" 2); c1=$(cnt '127.0.0.0/8')
  [ "$c1" -eq "$c0" ] && ok V5-16 "127.1.2.3 namespace-local: never reached the host chain (curl ${r%% *}); A's scope" || ng V5-16 "127.1.2.3 hit the host chain?"
  # UDP and ICMP separately: one datagram / one echo request out on the veth, the counter moves, nothing comes back
  capture_start "$V" "host 10.0.0.1 and udp" /var/tmp/ev-udp.pcap >/dev/null 2>&1 || ng V5-1 "udp capture not ready"
  c0=$(cnt '10.0.0.0/8'); alp "echo x | nc -u -w 1 10.0.0.1 9" >/dev/null; c1=$(cnt '10.0.0.0/8'); capture_stop /var/tmp/ev-udp.pcap
  local out back; out=$(pkts /var/tmp/ev-udp.pcap "src net $(subnet)"); back=$(pkts /var/tmp/ev-udp.pcap "dst net $(subnet)")
  [ "$c1" -ge $((c0+1)) ] && [ "$out" = 1 ] && [ "$back" = 0 ] && ok V5-1 "UDP to 10.0.0.1:9 firewall-dropped (+$((c1-c0)); 1 datagram out, 0 back)" || ng V5-1 "UDP to 10.0.0.1: counter $c0->$c1, veth out=$out back=$back"
  capture_start "$V" "host 10.0.0.1 and icmp" /var/tmp/ev-icmp.pcap >/dev/null 2>&1 || ng V5-1 "icmp capture not ready"
  c0=$(cnt '10.0.0.0/8'); alp "ping -c 1 -W 1 10.0.0.1 >/dev/null 2>&1" >/dev/null; c1=$(cnt '10.0.0.0/8'); capture_stop /var/tmp/ev-icmp.pcap
  out=$(pkts /var/tmp/ev-icmp.pcap "src net $(subnet)"); back=$(pkts /var/tmp/ev-icmp.pcap "dst net $(subnet)")
  [ "$c1" -ge $((c0+1)) ] && [ "$out" = 1 ] && [ "$back" = 0 ] && ok V5-1 "ICMP echo to 10.0.0.1 firewall-dropped (+$((c1-c0)); 1 request out, 0 replies)" || ng V5-1 "ICMP to 10.0.0.1: counter $c0->$c1, veth out=$out back=$back"
  if [ -n "$OBSERVER" ]; then local t0; t0=$(now); r=$(curlx "http://$OBSERVER/" 2)
    [ "${r%% *}" = 28 ] && [ "$(xobs_accepts "$t0")" = 0 ] && ok V5-1 "external observer $OBSERVER firewall-dropped (curl 28, 0 accepts recorded there)" || ng V5-1 "external observer $OBSERVER: curl '$r', accepts=$(xobs_accepts "$t0")"; fi
  # a name that resolves to a prohibited address: B judges the address, whatever the name said
  local ans; ans=$(alp "nslookup 10.0.0.1.nip.io 2>/dev/null | awk '/^Address/{print \$2}' | grep -v '#' | tail -1")
  c0=$(cnt '10.0.0.0/8'); r=$(curlx "http://10.0.0.1.nip.io/" 3); c1=$(cnt '10.0.0.0/8')
  [ "$ans" = 10.0.0.1 ] && [ "${r%% *}" = 28 ] && [ "$c1" -gt "$c0" ] && ok V5-1 "name resolving to a private address (10.0.0.1.nip.io -> $ans) firewall-dropped (+$((c1-c0)))" || ng V5-1 "DNS-derived private destination: answer '$ans', curl '$r', counter $c0->$c1"
  capture_stop /var/tmp/ev-veth.pcap; capture_stop /var/tmp/ev-uplink.pcap
  local a u probe_pkts other_pkts obsport synack; a=$(pkts /var/tmp/ev-veth.pcap "src net $(subnet)"); u=$(pkts /var/tmp/ev-uplink.pcap); obsport=${OBSERVER#*:}
  isnum "$a" && isnum "$u" || { ng V5-1 "captures unreadable (veth=$a uplink=$u)"; return; }
  probe_pkts=$(pkts /var/tmp/ev-uplink.pcap "dst port 80 or dst port 9 or icmp or dst port $OBS_PORT${obsport:+ or dst port $obsport}"); other_pkts=$((u - probe_pkts))
  [ "$a" -ge 16 ] && ok V5-1 "attempts seen on the veth: $a packets" || ng V5-1 "only $a attempt packets on the veth"
  [ "$probe_pkts" = 0 ] && [ "$other_pkts" -ge 1 ] && ok V5-1 "uplink $UPLINK: 0 probe packets to deny ranges; $other_pkts host-originated packets to those ranges prove the capture was live" || ng V5-1 "uplink $UPLINK: probe packets=$probe_pkts, other=$other_pkts (a live capture must see some host traffic to those ranges)"
  synack=$(pkts /var/tmp/ev-veth.pcap "dst net $(subnet) and tcp[tcpflags] & (tcp-syn|tcp-ack) == (tcp-syn|tcp-ack)")
  [ "$synack" = 0 ] && ok V5-1 "no SYN-ACK from any denied source returned to the namespace (capture includes the return direction)" || ng V5-1 "$synack SYN-ACKs from denied sources seen on the veth"
  local ct; ct=$(conntrack -L 2>/dev/null | grep "src=$(ns_ip) " | grep -c -E "$MATRIX_RE")
  [ "${ct:-0}" -eq 0 ] && ok V5-1 "no conntrack entries for the new dropped flows (unconfirmed entries are discarded on drop)" || ng V5-1 "$ct conntrack entries exist for matrix destinations"
}

# ---------------------------------------------------------------- host addresses, loopback
host_addresses() {
  echo "== V5-2 host addresses =="
  hobs_start || { ng V5-2 "host observer not ready"; return; }
  local rip t0; rip=$(ns_ip); t0=$(now)
  for a in $(host_addrs4) $(env_value HOST_ADDRS4 | tr ' ' '\n' | grep -v '^none$'); do
    case "$a" in 127.*) continue ;; esac
    local c0 c1 r; c0=$(cnt "$a"); [ -z "$c0" ] && { ng V5-2 "$a has no inventory line in the chain"; continue; }
    r=$(curlx "http://$a:$OBS_PORT/" 2); c1=$(cnt "$a")
    [ "${r%% *}" = 28 ] && [ "$c1" -gt "$c0" ] && ok V5-2 "$a firewall-dropped (inventory +$((c1-c0)))" || ng V5-2 "$a: curl '$r', counter $c0->$c1"
  done
  [ "$(hobs_accepts "$t0")" = 0 ] && ok V5-2 "host observer accepted 0 connections during the host-address probes" || ng V5-2 "host observer accepted $(hobs_accepts "$t0") connections"
  # positive control for the host observer itself
  local t1; t1=$(now); curl -s -m 2 -o /dev/null -H 'X-Control: host' "http://127.0.0.1:$OBS_PORT/"
  [ "$(hobs_lines "$t1" X-Control)" -ge 1 ] && ok V5-2 "host observer records a control connection (it was working)" || ng V5-2 "host observer did not record the control connection"
  local tok pub; tok=$(curl -s -m 2 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token 2>/dev/null)
  if [ -n "$tok" ]; then
    pub=$(curl -s -m 2 -H "X-aws-ec2-metadata-token: $tok" http://169.254.169.254/latest/meta-data/public-ipv4 2>/dev/null)
    if [ -n "$pub" ]; then echo " $(env_value HOST_ADDRS4) " | grep -q " $pub " && ok V5-2 "public IPv4 $pub is in HOST_ADDRS4" || ng V5-2 "public IPv4 $pub is NOT in HOST_ADDRS4 (hairpin via the gateway stays open)"
    else note V5-2 "instance has no public IPv4"; fi
  else note V5-2 "IMDS not reachable from the host (not EC2, or endpoint disabled): the public address must be listed in HOST_ADDRS4 by hand"; fi
  hobs_stop
  local h; h=$(curlx "$HEALTH_URL" 3)
  [ "${h#* }" = 200 ] && ok V5-16 "loopback $HEALTH_URL from inside the namespace: 200 (namespace-local; A's scope)" || note V5-16 "loopback from inside the namespace: '$h' (HEALTH_URL=$HEALTH_URL)"
}

# ---------------------------------------------------------------- controls, DNS
controls() {
  echo "== V5-7 controls =="
  local h r; h=$(curl -s -o /dev/null -m 3 -w '%{http_code}' "$HEALTH_URL")
  [ "$h" = 200 ] && ok V5-7 "host -> Router $HEALTH_URL: 200 (Caddy path)" || ng V5-7 "host -> Router $HEALTH_URL: $h"
  local c0 c1; c0=$(cnt_reply); curl -s -o /dev/null -m 3 "$HEALTH_URL"; c1=$(cnt_reply)
  [ "$c1" -gt "$c0" ] && ok V5-7 "reply-direction exemption counted (+$((c1-c0)))" || ng V5-7 "reply exemption line did not count"
  r=$(curlx "https://example.com/" 6); [ "${r%% *}" = 0 ] && ok V5-7 "namespace -> public HTTPS: ${r#* }" || ng V5-7 "namespace -> public HTTPS: '$r'"
  echo "== V5-8 DNS =="
  local V; V=$(veth_of "$NS") || return
  capture_start "$V" "port 53" /var/tmp/ev-dns.pcap || { ng V5-8 "DNS capture not ready"; return; }
  local name="v$(date +%s%N | cut -c1-13).1.1.1.1.nip.io"
  r=$(probe "curl -s -o /dev/null -m 5 -w '%{exitcode} %{remote_ip}' http://$name/")
  capture_stop /var/tmp/ev-dns.pcap
  local d; d=$(pkts /var/tmp/ev-dns.pcap)
  [ "${r#* }" = 1.1.1.1 ] && ok V5-8 "uncached name $name resolved to 1.1.1.1" || ng V5-8 "uncached name resolution: '$r'"
  [ "$d" = 0 ] && ok V5-8 "0 DNS packets on the veth: the embedded resolver forwards from the host namespace on this Docker version" || ng V5-8 "DNS packets on the veth: $d (override present, or a Docker version that forwards from the container namespace)"
  for up in $( (awk '/^nameserver/{print $2}' /run/systemd/resolve/resolv.conf 2>/dev/null; awk '/^nameserver/{print $2}' /etc/resolv.conf) | grep -v '^127\.' | sort -u); do
    local line; line=$(deny_line_of "$up")
    if [ -n "$line" ]; then local c0 c1; c0=$(cnt "$line"); r=$(curlx "http://$up:53/" 2); c1=$(cnt "$line")
      [ "${r%% *}" = 28 ] && [ "$c1" -gt "$c0" ] && ok V5-8 "HTTP to upstream resolver $up:53 firewall-dropped (curl 28, $line +$((c1-c0)))" || ng V5-8 "HTTP to $up:53: curl '$r', counter $c0->$c1"
    else note V5-8 "upstream resolver $up is a public address: HTTP to it is permitted by the policy (not a prohibited destination)"; fi
  done
}

# ---------------------------------------------------------------- atomicity, IPv6
atomicity() {
  echo "== V5-10 reapply atomicity =="
  if command -v strace >/dev/null 2>&1; then
    local n; n=$(strace -f -e trace=sendmsg -o /var/tmp/ev-strace.txt sh -c "$SCRIPT render 4 | iptables-restore --noflush" 2>/dev/null; grep -c 'sendmsg(' /var/tmp/ev-strace.txt)
    [ "$n" -eq 1 ] && ok V5-10 "one restore = 1 netlink sendmsg (single batch)" || ng V5-10 "restore issued $n sendmsg calls"
  else ng V5-10 "strace not installed: the single-batch property is not measured on this host"; fi
  hobs_start || { ng V5-10 "host observer not ready"; return; }
  local gw rip c0 c1 t0; gw=$(gateway_ip); rip=$(ns_ip)
  hammer() { docker run --rm --name egress-verify-hammer --network "container:$NS" --entrypoint sh "$PROBE_IMAGE" -c "for i in \$(seq 1 200); do curl -s -o /dev/null -m 0.5 http://$gw:$OBS_PORT/ & done; wait" >/dev/null 2>&1; }
  c0=$(cnt "$gw"); hammer; c1=$(cnt "$gw")
  [ "$c1" -ge $((c0+100)) ] && ok V5-10 "hammer sanity: 200 concurrent SYNs raised the inventory counter by $((c1-c0))" || ng V5-10 "hammer sanity: counter only +$((c1-c0))"
  t0=$(now); ( sleep 0.3; hammer ) & local hp=$!
  for i in $(seq 1 20); do "$SCRIPT" apply >/dev/null || ng V5-10 "apply failed during the reapply loop"; done; wait $hp; sleep 1
  [ "$(hobs_accepts "$t0")" = 0 ] && ok V5-10 "200 concurrent SYNs during 20 reapplies: 0 connections accepted by the host observer" || ng V5-10 "$(hobs_accepts "$t0") connections accepted during reapply"
  hobs_stop
  echo "== V5-14 IPv6 =="
  local d; d=$(docker exec "$NS" cat /proc/sys/net/ipv6/conf/eth0/disable_ipv6 2>/dev/null)
  [ "$d" = 1 ] && ok V5-14 "IPv6 disabled inside the namespace (disable_ipv6=1): no IPv6 traffic can originate" || ng V5-14 "IPv6 enabled inside the namespace (disable_ipv6=$d): IPv6 enforcement is not covered by this runner"
  [ "$(ip6tables -t mangle -S SUBETHA-EGRESS 2>/dev/null | grep -c -- '-j DROP')" -ge 16 ] && ok V5-14 "ip6tables chain has $(ip6tables -t mangle -S SUBETHA-EGRESS | grep -c -- '-j DROP') DROP rules (installed, not exercised)" || ng V5-14 "ip6tables chain incomplete"
  local r; r=$(alp "wget -q -T 2 -O /dev/null 'http://[fe80::1%eth0]:$OBS_PORT/' 2>&1 | head -1")
  echo "$r" | grep -qi 'unreachable\|bad address\|can.t connect' && ok V5-14 "link-local IPv6 attempt kernel-rejected ($r)" || ng V5-14 "link-local IPv6 attempt: '$r'"
}


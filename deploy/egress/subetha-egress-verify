#!/bin/bash
# subetha-egress-verify: run the acceptance protocol of docs/ssrf-egress-design.md §23 on the
# host and print evidence for every item. Exit status is non-zero if any item fails, including
# a failed restoration at the end. Every required observation is a gate: instrumentation that
# fails to start, a setup step that fails, a command whose status cannot be read, or an observer
# whose session changed, fails the item. Raw evidence (captures, observer reports, journal
# excerpts, shim logs, this output) is kept under /var/tmp/egress-verify-<timestamp>-<mode>/.
#
#   sudo subetha-egress-verify                  non-disruptive items + preconditions (Router running)
#   sudo subetha-egress-verify --adversarial    Router STOPPED (verified by a successful query): a stand-in
#                                               container on the Router's network takes its place; temporary
#                                               host alias and containers, policy removal/re-apply, sabotage
#                                               of `check`, attributable fault injection, both DNAT paths,
#                                               guard recovery. Requires OBSERVER/OBSERVER_REPORT.
#   sudo subetha-egress-verify --fail-closed    stops Docker, breaks the env file, proves Docker stays down
#                                               through its restart retries (journal diagnostics), restores.
#   sudo subetha-egress-verify --reboot-prepare installs the probe container and the boot-ordered observer
#                                               units (plus a test-only docker drop-in); records the boot id,
#                                               the observer configuration, session and cursor. Then reboot.
#   sudo subetha-egress-verify --post-boot      reads the boot-ordered evidence after the reboot.
#   sudo subetha-egress-verify --reboot-cleanup removes the probe container, observers and the drop-in.
#
# Environment: ROUTER (container, default subetha-router), NET (default subetha-router-net), BRIDGE
# (default subetha0), UPLINK (default: default-route interface), HEALTH_URL (default
# http://127.0.0.1:8787/healthz; must be the same URL inside and outside the container),
# OBSERVER=<rfc1918 ip>:<port> and OBSERVER_REPORT=<ip>:<port>: an external host you control running
# deploy/egress/egress-observer.py (--port / --report-port). ALLOW_NO_BACKLOG=1 downgrades a missing
# `ss` on an observer from FAIL to INFO (test environments only; production observers run Linux).
set -u
ROUTER=${ROUTER:-subetha-router}; NET=${NET:-subetha-router-net}; BRIDGE=${BRIDGE:-subetha0}
UPLINK=${UPLINK:-$(ip -4 route show default | awk '{print $5; exit}')}
HEALTH_URL=${HEALTH_URL:-http://127.0.0.1:8787/healthz}
OBSERVER=${OBSERVER:-}; OBSERVER_REPORT=${OBSERVER_REPORT:-}; ALLOW_NO_BACKLOG=${ALLOW_NO_BACKLOG:-0}
ENV_FILE=${SUBETHA_EGRESS_ENV:-/etc/subetha-egress.env}
PROBE_IMAGE=${PROBE_IMAGE:-curlimages/curl:latest}; ALPINE_IMAGE=${ALPINE_IMAGE:-alpine:latest}; PY_IMAGE=${PY_IMAGE:-python:3-alpine}
SCRIPT=${SCRIPT:-/usr/local/sbin/subetha-egress}
UNIT_DIR=${UNIT_DIR:-/usr/local/lib/subetha-egress}
OBS_PORT=19998; OBS_REPORT=19997        # host-side observer ports
REGISTRY_DATE=2025-10-09; CAPTURE_SECONDS=${CAPTURE_SECONDS:-900}
PREP=/var/tmp/egress-verify-prepared
MSGID_STARTED=39f53479d3a045ac8e11786248231fbf   # systemd: "Started <unit>"
MODE=standard
for a in "$@"; do case "$a" in
  --adversarial) MODE=adversarial ;; --fail-closed) MODE=fail-closed ;; --reboot-prepare) MODE=reboot-prepare ;;
  --post-boot) MODE=post-boot ;; --reboot-cleanup) MODE=reboot-cleanup ;;
  *) echo "unknown option $a" >&2; exit 64 ;; esac; done
EVID=/var/tmp/egress-verify-$(date -u +%Y%m%dT%H%M%SZ)-$MODE; mkdir -p "$EVID"
exec > >(tee -a "$EVID/runner.log") 2>&1
echo "== subetha-egress-verify $MODE; evidence in $EVID =="

pass=0; fail=0; info=0
ok()   { pass=$((pass+1)); printf 'PASS %-6s %s\n' "$1" "$2"; }
ng()   { fail=$((fail+1)); printf 'FAIL %-6s %s\n' "$1" "$2"; }
note() { info=$((info+1)); printf 'INFO %-6s %s\n' "$1" "$2"; }
need() { command -v "$1" >/dev/null 2>&1 || { echo "missing tool: $1" >&2; exit 69; }; }
for t in docker iptables ip6tables tcpdump conntrack curl python3 ip awk flock; do need "$t"; done
[ -r "$UNIT_DIR/egress-observer.py" ] || { echo "missing $UNIT_DIR/egress-observer.py" >&2; exit 69; }

NS=$ROUTER   # the container whose network namespace the probes join (the stand-in in adversarial mode)
probe()  { docker run --rm --network "container:$NS" --entrypoint sh "$PROBE_IMAGE" -c "$1" 2>/dev/null; }
alp()    { docker run --rm --network "container:$NS" "$ALPINE_IMAGE" sh -c "$1" 2>/dev/null; }
curlx()  { probe "curl -s -o /dev/null -m ${2:-2} -w '%{exitcode} %{http_code}' '$1'"; }
veth_of(){ local idx; idx=$(docker exec "$1" cat /sys/class/net/eth0/iflink 2>/dev/null) || return 1
           ip -o link | awk -F': ' -v i="$idx" '$1==i{print $2}' | cut -d@ -f1; }
cnt()    { iptables -t mangle -L SUBETHA-EGRESS -n -v -x 2>/dev/null | awk -v n="${1%/32}" 'NR>2 && $9==n {print $1; exit}'; }
cnt_reply() { iptables -t mangle -L SUBETHA-EGRESS -n -v -x 2>/dev/null | awk 'NR==3 {print $1}'; }
ns_ip()  { docker inspect "$NS" --format "{{(index .NetworkSettings.Networks \"$NET\").IPAddress}}" 2>/dev/null; }
gateway_ip() { docker network inspect "$NET" --format '{{(index .IPAM.Config 0).Gateway}}' 2>/dev/null; }
subnet()  { docker network inspect "$NET" --format '{{(index .IPAM.Config 0).Subnet}}' 2>/dev/null; }
host_addrs4() { ip -4 -o addr show | awk '{print $4}' | cut -d/ -f1 | grep -v '^169\.254\.' | sort -u; }
env_value() { awk -F= -v k="$1" '$1==k{v=$2; gsub(/"/,"",v); print v}' "$ENV_FILE" 2>/dev/null; }
now()    { date +%s.%N; }
isnum()  { [ "$1" -ge 0 ] 2>/dev/null; }
unit_prop() { systemctl show "$1" -p "$2" --value 2>/dev/null; }
unit_starts() { journalctl -q -b -u "$1" -o json "MESSAGE_ID=$MSGID_STARTED" 2>/dev/null | grep -c '"MESSAGE_ID"'; }

# ---- observers (egress-observer.py v3). Every report used for a verdict is bound to the expected session.
XSESSION=""; HSESSION=""
obs_get() { # $1 url, $2 since_seq, $3 expected session; "unbound" only for evidence dumps -> JSON or "ERR ..."
  [ -n "$3" ] || { echo "ERR unbound session"; return; }; local exp=$3; [ "$exp" = unbound ] && exp=""
  local body; body=$(curl -s -m 5 "http://$1/?since_seq=${2:-0}" 2>/dev/null) || { echo "ERR unreachable"; return; }
  printf '%s' "$body" | python3 -c 'import json,sys
exp=sys.argv[1]
try: d=json.load(sys.stdin)
except Exception: print("ERR not json"); sys.exit(0)
if exp and d.get("session")!=exp: print("ERR session "+str(d.get("session"))+" != "+exp); sys.exit(0)
if not isinstance(d.get("seq_last"),int): print("ERR seq"); sys.exit(0)
print(json.dumps(d))' "$exp"; }
obs_field() { # $1 url, $2 field, $3 session
  local j; j=$(obs_get "$1" 0 "$3"); case "$j" in ERR*) echo "$j"; return;; esac
  printf '%s' "$j" | python3 -c 'import json,sys; d=json.load(sys.stdin); v=d.get(sys.argv[1]); print("null" if v is None else (json.dumps(v) if isinstance(v,(dict,list)) else v))' "$2"; }
obs_count() { # $1 url, $2 since_seq, $3 session, $4 kind, $5 substring
  local j; j=$(obs_get "$1" "$2" "$3"); case "$j" in ERR*) echo "$j"; return;; esac
  printf '%s' "$j" | python3 -c 'import json,sys
kind=sys.argv[1]; pat=sys.argv[2]; d=json.load(sys.stdin)
print(sum(1 for r in d["rows"] if r["kind"]==kind and (not pat or pat in r.get("data",""))))' "$4" "${5:-}"; }
obs_settle() { # $1 url, $2 session: seq_last unchanged for 1 s (no accept in flight) -> prints seq_last, or ERR
  local a b; a=$(obs_field "$1" seq_last "$2"); case "$a" in ERR*) echo "$a"; return 1;; esac
  for i in 1 2 3 4 5; do sleep 1; b=$(obs_field "$1" seq_last "$2"); [ "$a" = "$b" ] && { echo "$b"; return 0; }; a=$b; done; echo "ERR unsettled"; return 1; }
obs_backlog() { # $1 url, $2 session -> "0" when supported and empty, "N" when pending, "unsupported:<err>", or ERR
  local bl; bl=$(obs_field "$1" backlog "$2"); case "$bl" in ERR*) echo "$bl"; return;; esac
  printf '%s' "$bl" | python3 -c 'import json,sys
b=json.load(sys.stdin)
print(b["value"] if b.get("supported") else "unsupported:"+str(b.get("error")))'; }
obs_health() { curl -sf -m 3 "http://$1/health" 2>/dev/null; }   # prints the session id on 200
obs_save() { obs_get "$1" 0 unbound > "$EVID/observer-$2.json"; }
# one coordinated report: accepts since $2 (optionally only rows whose data contains $4), seq_last, backlog, listening
obs_verdict() { # $1 url, $2 since_seq, $3 session, [$4 substring] -> "accepts=N seq=M backlog=B listening=L" or "ERR ..."
  local j; j=$(obs_get "$1" "$2" "$3"); case "$j" in ERR*) echo "$j"; return;; esac
  printf '%s' "$j" | python3 -c 'import json,sys
pat=sys.argv[1]; d=json.load(sys.stdin); b=d.get("backlog") or {}
acc=sum(1 for r in d["rows"] if r["kind"]=="accept"); lines=sum(1 for r in d["rows"] if r["kind"]=="line" and pat and pat in r.get("data",""))
bl=str(b.get("value")) if b.get("supported") else "unsupported:"+str(b.get("error"))
print("accepts=%d seq=%d backlog=%s listening=%s marked=%d" % (acc, d["seq_last"], bl, d.get("listening"), lines))' "${4:-}"; }
vf() { printf '%s' "$1" | sed -n "s/.*$2=\([^ ]*\).*/\1/p"; }   # field of a verdict string
control_after() { # $1 item, $2 label, $3 url, $4 boundary seq (from the zero verdict), $5 session, $6 control url
  curl -s -m 3 -o /dev/null -H 'X-Control: host' "$6"; sleep 0.5
  local vd; vd=$(obs_verdict "$3" "$4" "$5" X-Control); case "$vd" in ERR*) ng "$1" "$2: control report invalid ($vd)"; return 1;; esac
  [ "$(vf "$vd" accepts)" = 1 ] && [ "$(vf "$vd" marked)" -ge 1 ] && ok "$1" "$2: exactly 1 accept since the verdict's seq $4 and it carries X-Control (nothing slipped between verdict and control)" || ng "$1" "$2: control not the only accept since seq $4 ($vd)"; }
backlog_ok() { # $1 backlog field -> 0 ok, 1 fail, 2 waived
  case "$1" in 0) return 0 ;; unsupported:*) [ "$ALLOW_NO_BACKLOG" = 1 ] && return 2 || return 1 ;; *) return 1 ;; esac; }
ZA_SEQ=""
zero_accepts() { # $1 item, $2 label, $3 url, $4 since_seq, $5 session: one report must show 0 accepts, backlog 0, listening.
                 # ZA_SEQ receives that report's seq_last: callers use it as the control boundary (no second report)
  local vd; vd=$(obs_verdict "$3" "$4" "$5"); ZA_SEQ=""; case "$vd" in ERR*) ng "$1" "$2: report invalid ($vd)"; return 1;; esac
  ZA_SEQ=$(vf "$vd" seq)
  local acc bl; acc=$(vf "$vd" accepts); bl=$(vf "$vd" backlog); backlog_ok "$bl"; local bk=$?
  if [ "$acc" = 0 ] && [ "$(vf "$vd" listening)" = True ] && [ "$bk" != 1 ]; then
    [ "$bk" = 2 ] && note "$1" "$2: backlog not reportable ($bl) -- waived by ALLOW_NO_BACKLOG=1 (test environments only)"
    ok "$1" "$2: 0 accepts since seq $4, backlog $bl, listening (one session-bound report)"; return 0
  else ng "$1" "$2: $vd"; return 1; fi; }
hobs_url() { echo "127.0.0.1:$OBS_REPORT"; }
hobs_start() { hobs_stop; : > /var/tmp/egress-verify-hobs.log
  nohup python3 "$UNIT_DIR/egress-observer.py" --port "$OBS_PORT" --report-port "$OBS_REPORT" >> /var/tmp/egress-verify-hobs.log 2>&1 &
  echo $! > /var/tmp/egress-verify-hobs.pid
  for i in $(seq 1 50); do HSESSION=$(obs_health "$(hobs_url)") && [ -n "$HSESSION" ] && return 0; sleep 0.2; done
  echo "host observer did not become ready (/health)" >&2; return 1; }
hobs_stop() { [ -f /var/tmp/egress-verify-hobs.pid ] && { kill "$(cat /var/tmp/egress-verify-hobs.pid)" 2>/dev/null; rm -f /var/tmp/egress-verify-hobs.pid; }; return 0; }
hobs_seq() { obs_field "$(hobs_url)" seq_last "$HSESSION"; }
hobs_accepts() { obs_count "$(hobs_url)" "$1" "$HSESSION" accept; }
hobs_lines() { obs_count "$(hobs_url)" "$1" "$HSESSION" line "${2:-}"; }
xobs_seq() { obs_field "$OBSERVER_REPORT" seq_last "$XSESSION"; }
xobs_accepts() { obs_count "$OBSERVER_REPORT" "$1" "$XSESSION" accept; }
xobs_lines() { obs_count "$OBSERVER_REPORT" "$1" "$XSESSION" line "${2:-}"; }
require_observer() { [ -n "$OBSERVER" ] && [ -n "$OBSERVER_REPORT" ] || { echo "OBSERVER=<rfc1918 ip:port> and OBSERVER_REPORT=<ip:port> (egress-observer.py on a host you control) are required for this mode" >&2; exit 64; }
  XSESSION=$(obs_health "$OBSERVER_REPORT") && [ -n "$XSESSION" ] || { echo "external observer at $OBSERVER_REPORT is not reachable from the host or not listening (/health)" >&2; exit 69; }; }
backlog_gate() { # $1 item, $2 label, $3 url, $4 session
  local b; b=$(obs_backlog "$3" "$4")
  case "$b" in 0) ok "$1" "$2 backlog 0 (no connection waiting unaccepted)" ;;
    unsupported:*) [ "$ALLOW_NO_BACKLOG" = 1 ] && note "$1" "$2 cannot report its backlog ($b); accept counts are userspace counts (ALLOW_NO_BACKLOG=1)" || ng "$1" "$2 cannot report its backlog ($b): run the observer on Linux with ss" ;;
    *) ng "$1" "$2 backlog '$b'" ;; esac; }
# ---- captures: readiness is mandatory, unreadable captures are errors
capture_start() { rm -f "$3"; tcpdump -Z root -i "$1" -w "$3" -U "$2" >/dev/null 2>"$3.err" & echo $! > "$3.pid"
  for i in $(seq 1 30); do grep -q 'listening on' "$3.err" 2>/dev/null && return 0; sleep 0.1; done; echo "capture on $1 not ready" >&2; return 1; }
capture_stop() { kill -INT "$(cat "$1.pid")" 2>/dev/null; wait "$(cat "$1.pid")" 2>/dev/null; rm -f "$1.pid"; sleep 1; cp -f "$1" "$EVID/" 2>/dev/null; }
pkts()   { [ -s "$1" ] || { echo ERR; return; }; local o; o=$(tcpdump -nn -r "$1" ${2:+"$2"} 2>/dev/null) || { echo ERR; return; }; printf '%s' "$o" | grep -c .; }
guard_pause()  { systemctl stop subetha-egress-guard.timer subetha-egress-guard.service || return 1
  local u st; for u in subetha-egress-guard.timer subetha-egress-guard.service; do st=$(systemctl is-active "$u"); [ $? = 3 ] && [ "$st" = inactive ] || return 1; done; }
guard_resume() { systemctl start subetha-egress-guard.timer; }

DENY_FILTER='(dst net 0.0.0.0/8 or dst net 10.0.0.0/8 or dst net 100.64.0.0/10 or dst net 127.0.0.0/8 or dst net 169.254.0.0/16 or dst net 172.16.0.0/12 or dst net 192.0.0.0/24 or dst net 192.0.2.0/24 or dst net 192.88.99.0/24 or dst net 192.168.0.0/16 or dst net 198.18.0.0/15 or dst net 198.51.100.0/24 or dst net 203.0.113.0/24 or dst net 224.0.0.0/4 or dst net 240.0.0.0/4)'
SRC_FILTER='(src net 0.0.0.0/8 or src net 10.0.0.0/8 or src net 100.64.0.0/10 or src net 127.0.0.0/8 or src net 169.254.0.0/16 or src net 172.16.0.0/12 or src net 192.0.0.0/24 or src net 192.0.2.0/24 or src net 192.88.99.0/24 or src net 192.168.0.0/16 or src net 198.18.0.0/15 or src net 198.51.100.0/24 or src net 203.0.113.0/24 or src net 224.0.0.0/4 or src net 240.0.0.0/4)'
MATRIX_RE='dst=(0\.1\.2\.3|10\.0\.0\.1|100\.64\.0\.1|169\.254\.169\.254|172\.16\.0\.1|192\.0\.0\.1|192\.0\.2\.1|192\.88\.99\.1|192\.168\.0\.1|198\.18\.0\.1|198\.51\.100\.1|203\.0\.113\.1|240\.0\.0\.1) '
DENY_RANGES="0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.0.2.0/24 192.88.99.0/24 192.168.0.0/16 198.18.0.0/15 198.51.100.0/24 203.0.113.0/24 224.0.0.0/4 240.0.0.0/4"
deny_line_of() { python3 -c 'import ipaddress,sys
a=sys.argv[1]; ranges=sys.argv[2].split()
try:
    n=ipaddress.ip_network(a, strict=False)
    for r in ranges:
        if n.subnet_of(ipaddress.ip_network(r)): print(r); break
except Exception: pass' "$1" "$DENY_RANGES"; }

# ---------------------------------------------------------------- preconditions / facts (structural parsing)
dockerd_pid() { pidof dockerd | awk '{print $1}'; }
dockerd_cmdline() { tr '\0' ' ' < "/proc/$(dockerd_pid)/cmdline"; }
daemon_json_path() { local f; f=$(dockerd_cmdline 2>/dev/null | grep -o -- '--config-file[= ][^ ]*' | sed 's/--config-file[= ]//'); echo "${f:-/etc/docker/daemon.json}"; }
daemon_cfg() { python3 -c 'import json,sys,os
p=sys.argv[1]
if not os.path.exists(p): print("absent"); sys.exit(0)
try:
    d=json.load(open(p))
    for k in ("userland-proxy","dns","firewall-backend","live-restore"): print(f"{k}={json.dumps(d.get(k))}")
except Exception as e: print("ERR "+str(e))' "$(daemon_json_path)"; }
preconditions() {
  echo "== preconditions and facts (V7-0 / V7-15) =="
  "$SCRIPT" check >/dev/null 2>&1 && ok V7-0 "policy equals the rendered policy and the first rules of every hook are exactly our jumps (subetha-egress check)" || ng V7-0 "subetha-egress check failed: $("$SCRIPT" check 2>&1 | head -3 | tr '\n' ' ')"
  local running; running=$(docker inspect "$ROUTER" --format '{{.State.Running}}' 2>/dev/null) && [ "$running" = true ] && ok V7-0 "$ROUTER is running" || ng V7-0 "$ROUTER not running or not inspectable"
  local nets mode members
  nets=$(docker inspect "$ROUTER" --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}' 2>/dev/null)
  mode=$(docker inspect "$ROUTER" --format '{{.HostConfig.NetworkMode}}' 2>/dev/null)
  [ "$(echo $nets)" = "$NET" ] && [ "$mode" = "$NET" ] && ok V7-6 "complete attachment set is {$NET} (NetworkMode=$mode)" || ng V7-6 "attachment set '$nets' NetworkMode '$mode' (expected only $NET)"
  members=$(docker network inspect "$NET" --format '{{range .Containers}}{{.Name}} {{end}}' 2>/dev/null)
  [ "$(echo $members)" = "$ROUTER" ] && ok V7-6 "$NET contains only $ROUTER (singleton topology)" || ng V7-6 "$NET members: '$members' (expected only $ROUTER)"
  [ "$(docker network inspect "$NET" --format '{{index .Options "com.docker.network.bridge.name"}}')" = "$BRIDGE" ] && ok V7-0 "bridge name is $BRIDGE" || ng V7-0 "bridge name is not $BRIDGE"
  echo " $(env_value IFACES) " | grep -q " $BRIDGE " && ok V7-0 "IFACES covers $BRIDGE" || ng V7-0 "IFACES '$(env_value IFACES)' does not list $BRIDGE"
  local subs bad=0; subs=$(docker network inspect "$NET" --format '{{range .IPAM.Config}}{{.Subnet}} {{end}}' 2>/dev/null)
  [ -n "$(echo $subs)" ] || { ng V7-0 "$NET has no IPAM subnet"; bad=1; }
  for sn in $subs; do [ -n "$(deny_line_of "$sn")" ] || { ng V7-0 "$NET subnet $sn is not inside a denied range: its gateway would be reachable until the first inventory refresh"; bad=1; }; done
  [ "$bad" = 0 ] && ok V7-0 "every $NET subnet ($(echo $subs)) lies inside a denied range"
  [ "$(docker network inspect "$NET" --format '{{.EnableIPv6}}')" = false ] && ok V7-14 "$NET has IPv6 disabled" || ng V7-14 "$NET has IPv6 enabled: IPv6 enforcement is not covered by this runner"
  [ "$(docker info --format '{{.LiveRestoreEnabled}}')" = false ] && ok V7-15 "LiveRestoreEnabled=false (docker info)" || ng V7-15 "LiveRestoreEnabled=true: containers survive daemon stop; fail-closed does not hold"
  local fb; fb=$(docker info --format '{{.FirewallBackend.Driver}}' 2>/dev/null); [ "$fb" = iptables ] && ok V7-15 "docker firewall backend is iptables" || ng V7-15 "docker firewall backend is '$fb' (only iptables is designed and measured)"
  local fa fx; fa=$(systemctl is-active firewalld 2>/dev/null); fx=$?
  case "$fx:$fa" in 0:*) ng V7-15 "firewalld is $fa (reloads flush mangle; disable it)" ;; 3:inactive|3:failed|4:*) ok V7-15 "firewalld absent or inactive ($fa)" ;; *) ng V7-15 "firewalld state undetermined (exit $fx '$fa')" ;; esac
  local cmd; cmd=$(dockerd_cmdline 2>/dev/null) || { ng V7-15 "cannot read dockerd's command line"; cmd=ERR; }
  local cfg; cfg=$(daemon_cfg)
  case "$cfg" in ERR*) ng V7-15 "daemon config $(daemon_json_path) unreadable or invalid: $cfg" ;; absent) note V7-15 "no daemon config file at $(daemon_json_path) (defaults)" ;; esac
  if [ "$cmd" != ERR ] && ! echo "$cmd" | grep -q -- '--userland-proxy=false' && ! echo "$cfg" | grep -q '^userland-proxy=false$'; then ok V7-15 "userland-proxy default (cmdline and config parsed)"; else ng V7-15 "userland-proxy=false or undetermined: hairpin uses DNAT, a path this runner does not validate"; fi
  local esp; esp=$(unit_prop docker.service ExecStartPre)
  echo "$esp" | grep -q 'argv\[\]=/usr/local/sbin/subetha-egress apply ; ignore_errors=no' && ok V7-15 "docker.service ExecStartPre is exactly '/usr/local/sbin/subetha-egress apply' with ignore_errors=no" || ng V7-15 "docker.service ExecStartPre is not exactly 'subetha-egress apply' (ignore_errors=no): $(echo "$esp" | head -c 200)"
  [ "$(systemctl is-active subetha-egress-guard.timer)" = active ] && ok V7-15 "guard timer active" || ng V7-15 "guard timer not active"
  note V7-15 "kernel $(uname -r); docker $(docker version --format '{{.Server.Version}}') (DNS provenance measured on 28.3.3; V7-8 re-measures here); $(iptables -V); bridge-nf-call-iptables=$(cat /proc/sys/net/bridge/bridge-nf-call-iptables 2>/dev/null || echo absent)"
  note V7-15 "docker raw rules: $(iptables -t raw -S 2>/dev/null | grep -c -- '^-A'); nat DOCKER returns for bridges: $(iptables -t nat -S DOCKER 2>/dev/null | grep -c -- '-j RETURN'); docker mangle rules: $(iptables -t mangle -S 2>/dev/null | grep -v SUBETHA | grep -c -- '^-A')"
  for fam in ipv4 ipv6; do local upd; upd=$(curl -s -m 10 "https://www.iana.org/assignments/iana-$fam-special-registry/iana-$fam-special-registry.xml" | grep -o '<updated>[^<]*</updated>' | head -1 | sed 's/<[^>]*>//g')
    if [ -z "$upd" ]; then ng V7-15 "IANA $fam registry date not fetched: cannot confirm the snapshot is current"; elif [ "$upd" \> "$REGISTRY_DATE" ]; then ng V7-15 "IANA $fam registry updated $upd > snapshot $REGISTRY_DATE: review the deny list"; else ok V7-15 "IANA $fam registry snapshot $REGISTRY_DATE is current ($upd)"; fi; done
  [ "$(docker inspect "$ROUTER" --format '{{len .HostConfig.Dns}}{{len .HostConfig.DnsOptions}}{{len .HostConfig.DnsSearch}}')" = 000 ] && ok V7-8 "$ROUTER has no --dns/--dns-opt/--dns-search override" || ng V7-8 "$ROUTER overrides DNS (HostConfig.Dns*): the embedded resolver would forward from the container namespace"
  if [ "$cmd" != ERR ] && ! echo "$cmd" | grep -q -- '--dns[= ]' && ! echo "$cfg" | grep -q '^dns=\[' ; then ok V7-8 "no daemon dns override (cmdline and config parsed)"; else ng V7-8 "daemon dns override or undetermined: the embedded resolver would forward from the container namespace"; fi
  local resolv; resolv=$(docker exec "$ROUTER" cat /etc/resolv.conf 2>/dev/null | awk '/^nameserver/{print $2; exit}')
  [ "$resolv" = 127.0.0.11 ] && ok V7-8 "container resolver is the embedded DNS (127.0.0.11)" || ng V7-8 "container resolver is $resolv, not the embedded DNS"
  note V7-8 "host nameservers (inherited by the embedded resolver): $(awk '/^nameserver/{print $2}' /etc/resolv.conf | tr '\n' ' ')"
  { echo "cmdline: $cmd"; echo "config: $cfg"; echo "ExecStartPre: $esp"; docker info 2>/dev/null; } > "$EVID/docker-facts.txt"
}

# ---------------------------------------------------------------- matrix
matrix() {
  echo "== V7-1 matrix from the namespace of $NS (TCP; UDP; ICMP; captures both ways) =="
  local V; V=$(veth_of "$NS") || { ng V7-1 "cannot find the veth of $NS"; return; }
  capture_start "$UPLINK" "$DENY_FILTER" /var/tmp/ev-uplink.pcap || { ng V7-1 "uplink capture not ready"; return; }
  capture_start "$V" "(src net $(subnet) and $DENY_FILTER) or (dst net $(subnet) and $SRC_FILTER)" /var/tmp/ev-veth.pcap || { ng V7-1 "veth capture not ready"; capture_stop /var/tmp/ev-uplink.pcap; return; }
  for t in 0.1.2.3:0.0.0.0/8 10.0.0.1:10.0.0.0/8 100.64.0.1:100.64.0.0/10 169.254.169.254:169.254.0.0/16 172.16.0.1:172.16.0.0/12 192.0.0.1:192.0.0.0/24 192.0.2.1:192.0.2.0/24 192.88.99.1:192.88.99.0/24 192.168.0.1:192.168.0.0/16 198.18.0.1:198.18.0.0/15 198.51.100.1:198.51.100.0/24 203.0.113.1:203.0.113.0/24 240.0.0.1:240.0.0.0/4; do
    local ip=${t%%:*} range=${t#*:} c0 c1 r
    c0=$(cnt "$range"); r=$(curlx "http://$ip:80/" 2); c1=$(cnt "$range")
    if [ "${r%% *}" = 28 ] && [ "$c1" -gt "$c0" ]; then ok V7-1 "$ip TCP firewall-dropped (curl 28, $range +$((c1-c0)))"; else ng V7-1 "$ip: curl '$r', counter $c0->$c1"; fi
  done
  local c0 c1 r
  c0=$(cnt '224.0.0.0/4'); r=$(curlx "http://224.0.0.1:80/" 2); c1=$(cnt '224.0.0.0/4')
  [ "${r%% *}" = 7 ] && [ "$c1" -eq "$c0" ] && ok V7-1 "224.0.0.1 TCP kernel-rejected (curl 7, nothing sent)" || ng V7-1 "224.0.0.1 TCP: curl '$r', counter $c0->$c1"
  c0=$(cnt '224.0.0.0/4'); alp "echo x | nc -u -w 1 224.0.0.1 9" >/dev/null; c1=$(cnt '224.0.0.0/4')
  [ "$c1" -gt "$c0" ] && ok V7-1 "224.0.0.1 UDP firewall-dropped (+$((c1-c0)))" || ng V7-1 "224.0.0.1 UDP: counter $c0->$c1"
  c0=$(cnt '127.0.0.0/8'); r=$(curlx "http://127.1.2.3:80/" 2); c1=$(cnt '127.0.0.0/8')
  [ "$c1" -eq "$c0" ] && ok V7-16 "127.1.2.3 namespace-local: never reached the host chain (curl ${r%% *}); A's scope" || ng V7-16 "127.1.2.3 hit the host chain?"
  capture_start "$V" "host 10.0.0.1 and udp" /var/tmp/ev-udp.pcap || ng V7-1 "udp capture not ready"
  c0=$(cnt '10.0.0.0/8'); alp "echo x | nc -u -w 1 10.0.0.1 9" >/dev/null; c1=$(cnt '10.0.0.0/8'); capture_stop /var/tmp/ev-udp.pcap
  local out back; out=$(pkts /var/tmp/ev-udp.pcap "src net $(subnet)"); back=$(pkts /var/tmp/ev-udp.pcap "dst net $(subnet)")
  [ "$c1" -ge $((c0+1)) ] && [ "$out" = 1 ] && [ "$back" = 0 ] && ok V7-1 "UDP to 10.0.0.1:9 firewall-dropped (+$((c1-c0)); 1 datagram out, 0 back)" || ng V7-1 "UDP to 10.0.0.1: counter $c0->$c1, veth out=$out back=$back"
  capture_start "$V" "host 10.0.0.1 and icmp" /var/tmp/ev-icmp.pcap || ng V7-1 "icmp capture not ready"
  c0=$(cnt '10.0.0.0/8'); alp "ping -c 1 -W 1 10.0.0.1 >/dev/null 2>&1" >/dev/null; c1=$(cnt '10.0.0.0/8'); capture_stop /var/tmp/ev-icmp.pcap
  out=$(pkts /var/tmp/ev-icmp.pcap "src net $(subnet)"); back=$(pkts /var/tmp/ev-icmp.pcap "dst net $(subnet)")
  [ "$c1" -ge $((c0+1)) ] && [ "$out" = 1 ] && [ "$back" = 0 ] && ok V7-1 "ICMP echo to 10.0.0.1 firewall-dropped (+$((c1-c0)); 1 request out, 0 replies)" || ng V7-1 "ICMP to 10.0.0.1: counter $c0->$c1, veth out=$out back=$back"
  if [ -n "$OBSERVER" ]; then local s0; s0=$(xobs_seq); r=$(curlx "http://$OBSERVER/" 2)
    [ "${r%% *}" = 28 ] && ok V7-1 "external observer $OBSERVER: curl timed out (28)" || ng V7-1 "external observer $OBSERVER: curl '$r'"
    obs_settle "$OBSERVER_REPORT" "$XSESSION" >/dev/null; zero_accepts V7-1 "external observer $OBSERVER" "$OBSERVER_REPORT" "$s0" "$XSESSION"; fi
  local ans; ans=$(alp "nslookup 10.0.0.1.nip.io 2>/dev/null | awk '/^Address/{print \$2}' | grep -v '#' | tail -1")
  c0=$(cnt '10.0.0.0/8'); r=$(curlx "http://10.0.0.1.nip.io/" 3); c1=$(cnt '10.0.0.0/8')
  [ "$ans" = 10.0.0.1 ] && [ "${r%% *}" = 28 ] && [ "$c1" -gt "$c0" ] && ok V7-1 "name resolving to a private address (10.0.0.1.nip.io -> $ans) firewall-dropped (+$((c1-c0)))" || ng V7-1 "DNS-derived private destination: answer '$ans', curl '$r', counter $c0->$c1"
  capture_stop /var/tmp/ev-veth.pcap; capture_stop /var/tmp/ev-uplink.pcap
  local a u probe_pkts other_pkts obsport synack; a=$(pkts /var/tmp/ev-veth.pcap "src net $(subnet)"); u=$(pkts /var/tmp/ev-uplink.pcap); obsport=${OBSERVER#*:}
  isnum "$a" && isnum "$u" || { ng V7-1 "captures unreadable (veth=$a uplink=$u)"; return; }
  probe_pkts=$(pkts /var/tmp/ev-uplink.pcap "dst port 80 or dst port 9 or icmp or dst port $OBS_PORT${obsport:+ or dst port $obsport}"); other_pkts=$((u - probe_pkts))
  [ "$a" -ge 16 ] && ok V7-1 "attempts seen on the veth: $a packets" || ng V7-1 "only $a attempt packets on the veth"
  [ "$probe_pkts" = 0 ] && [ "$other_pkts" -ge 1 ] && ok V7-1 "uplink $UPLINK: 0 probe packets to deny ranges; $other_pkts host-originated packets to those ranges prove the capture was live" || ng V7-1 "uplink $UPLINK: probe packets=$probe_pkts, other=$other_pkts (a live capture must see some host traffic to those ranges)"
  synack=$(pkts /var/tmp/ev-veth.pcap "dst net $(subnet) and tcp[tcpflags] & (tcp-syn|tcp-ack) == (tcp-syn|tcp-ack)")
  [ "$synack" = 0 ] && ok V7-1 "no SYN-ACK from any denied source returned to the namespace (capture includes the return direction)" || ng V7-1 "$synack SYN-ACKs from denied sources seen on the veth"
  local ctl; ctl=$(conntrack -L 2>/dev/null) || { ng V7-1 "conntrack -L failed"; return; }
  local ct; ct=$(printf '%s\n' "$ctl" | grep "src=$(ns_ip) " | grep -c -E "$MATRIX_RE")
  [ "${ct:-0}" -eq 0 ] && ok V7-1 "no conntrack entries for the new dropped flows (unconfirmed entries are discarded on drop)" || ng V7-1 "$ct conntrack entries exist for matrix destinations"
}

# ---------------------------------------------------------------- host addresses, loopback
host_addresses() {
  echo "== V7-2 host addresses =="
  hobs_start || { ng V7-2 "host observer not ready"; return; }
  local s0; s0=$(hobs_seq)
  for a in $(host_addrs4) $(env_value HOST_ADDRS4 | tr ' ' '\n' | grep -v '^none$'); do
    case "$a" in 127.*) continue ;; esac
    local c0 c1 r; c0=$(cnt "$a"); [ -z "$c0" ] && { ng V7-2 "$a has no inventory line in the chain"; continue; }
    r=$(curlx "http://$a:$OBS_PORT/" 2); c1=$(cnt "$a")
    [ "${r%% *}" = 28 ] && [ "$c1" -gt "$c0" ] && ok V7-2 "$a firewall-dropped (inventory +$((c1-c0)))" || ng V7-2 "$a: curl '$r', counter $c0->$c1"
  done
  obs_settle "$(hobs_url)" "$HSESSION" >/dev/null || ng V7-2 "host observer did not settle"
  zero_accepts V7-2 "host observer during the host-address probes" "$(hobs_url)" "$s0" "$HSESSION" && control_after V7-2 "host observer control" "$(hobs_url)" "$ZA_SEQ" "$HSESSION" "http://127.0.0.1:$OBS_PORT/"
  local tok pub; tok=$(curl -s -m 2 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token 2>/dev/null)
  if [ -n "$tok" ]; then
    pub=$(curl -s -m 2 -H "X-aws-ec2-metadata-token: $tok" http://169.254.169.254/latest/meta-data/public-ipv4 2>/dev/null)
    if [ -n "$pub" ]; then echo " $(env_value HOST_ADDRS4) " | grep -q " $pub " && ok V7-2 "public IPv4 $pub is in HOST_ADDRS4" || ng V7-2 "public IPv4 $pub is NOT in HOST_ADDRS4 (hairpin via the gateway stays open)"
    else note V7-2 "instance has no public IPv4"; fi
  else [ "${ALLOW_NO_IMDS:-0}" = 1 ] && note V7-2 "IMDS not reachable from the host: public-address inventory not verifiable here (waived by ALLOW_NO_IMDS=1, test environments only)" || ng V7-2 "IMDS not reachable from the host: the public-address inventory cannot be verified (on EC2 this must succeed; set HttpTokens=required, not the endpoint disabled)"; fi
  obs_save "$(hobs_url)" host-addresses; hobs_stop
  local h; h=$(curlx "$HEALTH_URL" 3)
  [ "${h#* }" = 200 ] && ok V7-16 "loopback $HEALTH_URL from inside the namespace: 200 (namespace-local; A's scope)" || note V7-16 "loopback from inside the namespace: '$h' (HEALTH_URL=$HEALTH_URL)"
}

# ---------------------------------------------------------------- controls, DNS
controls() {
  echo "== V7-7 controls =="
  local h r; h=$(curl -s -o /dev/null -m 3 -w '%{http_code}' "$HEALTH_URL")
  [ "$h" = 200 ] && ok V7-7 "host -> Router $HEALTH_URL: 200 (the path Caddy uses as its upstream; not end-to-end TLS)" || ng V7-7 "host -> Router $HEALTH_URL: $h"
  local c0 c1; c0=$(cnt_reply); curl -s -o /dev/null -m 3 "$HEALTH_URL"; c1=$(cnt_reply)
  [ "$c1" -gt "$c0" ] && ok V7-7 "reply-direction exemption counted (+$((c1-c0)))" || ng V7-7 "reply exemption line did not count"
  r=$(curlx "https://example.com/" 6); [ "${r%% *}" = 0 ] && ok V7-7 "namespace -> public HTTPS: ${r#* }" || ng V7-7 "namespace -> public HTTPS: '$r'"
  dns_check V7-8
}
dns_check() {
  echo "== $1 DNS =="
  local V r; V=$(veth_of "$NS") || { ng "$1" "cannot find the veth of $NS"; return; }
  capture_start "$V" "port 53" /var/tmp/ev-dns.pcap || { ng "$1" "DNS capture not ready"; return; }
  local name="v$(date +%s%N | cut -c1-13).1.1.1.1.nip.io"
  r=$(probe "curl -s -o /dev/null -m 5 -w '%{exitcode} %{remote_ip}' http://$name/")
  capture_stop /var/tmp/ev-dns.pcap
  local d; d=$(pkts /var/tmp/ev-dns.pcap); isnum "$d" || { ng "$1" "DNS capture unreadable"; return; }
  [ "${r#* }" = 1.1.1.1 ] && ok "$1" "uncached name $name resolved to 1.1.1.1" || ng "$1" "uncached name resolution: '$r'"
  [ "$d" = 0 ] && ok "$1" "0 DNS packets on the veth: the embedded resolver forwards from the host namespace on this Docker version" || ng "$1" "DNS packets on the veth: $d (override present, or a Docker version that forwards from the container namespace)"
  for up in $( (awk '/^nameserver/{print $2}' /run/systemd/resolve/resolv.conf 2>/dev/null; awk '/^nameserver/{print $2}' /etc/resolv.conf) | grep -v '^127\.' | sort -u); do
    local line; line=$(deny_line_of "$up")
    if [ -n "$line" ]; then local c0 c1; c0=$(cnt "$line"); r=$(curlx "http://$up:53/" 2); c1=$(cnt "$line")
      [ "${r%% *}" = 28 ] && [ "$c1" -gt "$c0" ] && ok "$1" "HTTP to upstream resolver $up:53 firewall-dropped (curl 28, $line +$((c1-c0)))" || ng "$1" "HTTP to $up:53: curl '$r', counter $c0->$c1"
    else note "$1" "upstream resolver $up is a public address: HTTP to it is permitted by the policy (not a prohibited destination)"; fi
  done
}

# ---------------------------------------------------------------- atomicity, IPv6
atomicity() {
  echo "== V7-10 reapply atomicity (packet-level evidence from the measured invocation) =="
  if command -v strace >/dev/null 2>&1; then
    local n; n=$(strace -f -e trace=sendmsg -o "$EVID/strace-restore.txt" sh -c "$SCRIPT render 4 | iptables-restore --noflush" 2>/dev/null; grep -c 'sendmsg(' "$EVID/strace-restore.txt")
    [ "$n" -eq 1 ] && ok V7-10 "one IPv4 chain restore = 1 netlink sendmsg (single batch; jump placement is a separate step)" || ng V7-10 "restore issued $n sendmsg calls"
  else ng V7-10 "strace not installed: the single-batch property is not measured on this host"; fi
  hobs_start || { ng V7-10 "host observer not ready"; return; }
  local gw V s0; gw=$(gateway_ip); V=$(veth_of "$NS") || { ng V7-10 "cannot find the veth of $NS"; hobs_stop; return; }
  # SYNs from the namespace to the gateway's observer port, timestamped on the host clock
  capture_start "$V" "dst host $gw and tcp dst port $OBS_PORT and tcp[tcpflags] & tcp-syn != 0 and tcp[tcpflags] & tcp-ack == 0" /var/tmp/ev-hammer.pcap || { ng V7-10 "hammer capture not ready"; hobs_stop; return; }
  s0=$(hobs_seq)
  # the hammer records every curl's exit code; the loop runs while the hammer is firing
  docker run --rm --name egress-verify-hammer --network "container:$NS" --entrypoint sh "$PROBE_IMAGE" -c "sleep 0.5; for i in \$(seq 1 200); do (curl -s -o /dev/null -m 0.5 http://$gw:$OBS_PORT/; echo exit=\$?) & done; wait" > "$EVID/hammer.txt" 2>&1 & local hp=$!
  sleep 0.6; local l0 l1; l0=$(now); for i in $(seq 1 20); do "$SCRIPT" apply >/dev/null || ng V7-10 "apply failed during the reapply loop"; done; l1=$(now)
  wait $hp; local hx=$?; sleep 1; capture_stop /var/tmp/ev-hammer.pcap
  local total dropped leaked other inloop
  total=$(grep -c '^exit=' "$EVID/hammer.txt"); dropped=$(grep -c '^exit=28$' "$EVID/hammer.txt"); leaked=$(grep -c '^exit=0$' "$EVID/hammer.txt"); other=$((total - dropped - leaked))
  inloop=$(tcpdump -nn -tt -r /var/tmp/ev-hammer.pcap 2>/dev/null | awk -v a="$l0" -v b="$l1" '$1 >= a && $1 <= b' | wc -l)
  [ "$hx" = 0 ] && [ "$total" = 200 ] && [ "$leaked" = 0 ] && [ "$other" = 0 ] && ok V7-10 "hammer: 200/200 curls ran from the measured invocation, all timed out (dropped), none accepted, none failed otherwise" || ng V7-10 "hammer: exit=$hx total=$total dropped=$dropped leaked=$leaked other=$other"
  [ "$inloop" -ge 50 ] && ok V7-10 "$inloop SYNs from the namespace were on the veth within the reapply loop interval [$l0, $l1] (inclusive, host clock, fractional seconds; membership in the interval, not per-commit overlap)" || ng V7-10 "only $inloop SYNs fell inside the reapply loop window (hammer and loop did not overlap)"
  obs_settle "$(hobs_url)" "$HSESSION" >/dev/null || ng V7-10 "host observer did not settle"
  zero_accepts V7-10 "host observer during the reapplies" "$(hobs_url)" "$s0" "$HSESSION" && control_after V7-10 "host observer control after the hammer" "$(hobs_url)" "$ZA_SEQ" "$HSESSION" "http://127.0.0.1:$OBS_PORT/"
  obs_save "$(hobs_url)" atomicity; hobs_stop
  echo "== V7-14 IPv6 =="
  local d; d=$(docker exec "$NS" cat /proc/sys/net/ipv6/conf/eth0/disable_ipv6 2>/dev/null)
  [ "$d" = 1 ] && ok V7-14 "IPv6 disabled inside the namespace (disable_ipv6=1): no IPv6 traffic can originate" || ng V7-14 "IPv6 enabled inside the namespace (disable_ipv6=$d): IPv6 enforcement is not covered by this runner"
  [ "$(ip6tables -t mangle -S SUBETHA-EGRESS 2>/dev/null | grep -c -- '-j DROP')" -ge 16 ] && ok V7-14 "ip6tables chain has $(ip6tables -t mangle -S SUBETHA-EGRESS | grep -c -- '-j DROP') DROP rules (installed, not exercised)" || ng V7-14 "ip6tables chain incomplete"
  local r; r=$(alp "wget -q -T 2 -O /dev/null 'http://[fe80::1%eth0]:$OBS_PORT/' 2>&1 | head -1")
  echo "$r" | grep -qi 'unreachable\|bad address\|can.t connect' && ok V7-14 "link-local IPv6 attempt kernel-rejected ($r)" || ng V7-14 "link-local IPv6 attempt: '$r'"
}

# ---------------------------------------------------------------- adversarial (Router stopped, stand-in on its network)
ADV_ACTIVE=0; A=11.22.33.44; SHIM=/var/tmp/egress-verify-fakebin; SHIMLOG=/var/tmp/egress-verify-shim.log
adv_cleanup() { # restore everything the adversarial mode may have altered; every step is checked and the
                # final state is proven by successful queries; any failure fails the run
  [ "$ADV_ACTIVE" = 1 ] || return 0; ADV_ACTIVE=0; local bad=0 rules addrs names r
  if [ -f /var/tmp/egress-verify-env.bak ]; then cp /var/tmp/egress-verify-env.bak "$ENV_FILE" || bad=1; fi
  rules=$(iptables -t nat -S PREROUTING 2>/dev/null) || bad=1
  while read -r r; do [ -n "$r" ] || continue; iptables -t nat ${r/-A/-D} || bad=1; done <<< "$(printf '%s\n' "$rules" | grep -- "-d $A/32")"
  ip -4 -o addr show dev "$UPLINK" 2>/dev/null | grep -q "$A/32" && { ip addr del $A/32 dev "$UPLINK" || bad=1; }
  local c; for c in egress-verify-target egress-verify-stream egress-verify-hammer egress-verify-standin; do docker rm -f "$c" >/dev/null 2>&1; done
  rm -rf "$SHIM"; hobs_stop
  "$SCRIPT" apply >/dev/null 2>&1 || bad=1; "$SCRIPT" check >/dev/null 2>&1 || bad=1
  guard_resume || bad=1; [ "$(systemctl is-active subetha-egress-guard.timer)" = active ] || bad=1
  rules=$(iptables -t nat -S PREROUTING) || bad=1; printf '%s\n' "$rules" | grep -q -- "-d $A/32" && bad=1
  addrs=$(ip -4 -o addr show dev "$UPLINK") || bad=1; printf '%s\n' "$addrs" | grep -q "$A/32" && bad=1
  names=$(docker ps -a --format '{{.Names}}') || bad=1; printf '%s\n' "$names" | grep -qE '^egress-verify-' && bad=1
  [ -e "$SHIM" ] && bad=1; [ -f /var/tmp/egress-verify-hobs.pid ] && bad=1
  local mg; mg=$(iptables -t mangle -S) || bad=1; printf '%s\n' "$mg" | grep -qE 'SUBETHA-EGRESS-BYPASS|--dport 6500[01] ' && bad=1
  [ "$bad" = 0 ] && ok V7-17 "restoration verified by fresh queries: env restored, no nat rule or alias for $A, no egress-verify-* container, shim dir and host observer gone, no sabotage rule or look-alike chain, policy verified, timer active" || ng V7-17 "restoration after the adversarial items incomplete; inspect the host"
}
trap 'rc=$?; adv_cleanup; [ "$rc" = 0 ] || ng V7-0 "invocation ended early with exit $rc (a prerequisite was refused or a step aborted)"; echo "== summary: $pass passed, $fail failed, $info notes; evidence: $EVID =="; exit $(( fail > 0 || rc != 0 ))' EXIT
sab() { "$@" >/dev/null 2>&1 || { ng V7-17 "sabotage setup failed: $*"; return 1; }; }
router_stopped() { local st; if st=$(docker inspect -f '{{.State.Running}}' "$ROUTER" 2>/dev/null); then [ "$st" = false ]; else
    local names; names=$(docker ps -a --format '{{.Names}}' 2>/dev/null) || return 1; ! printf '%s\n' "$names" | grep -qx "$ROUTER"; fi; }
shim_install() { # $1 tool name; the shim logs every invocation and rejects the configured argv pattern
  mkdir -p "$SHIM"; : > "$SHIMLOG"
  cat > "$SHIM/$1" <<'SHIMEOF'
#!/bin/sh
echo "CALL $(basename "$0") $*" >> "$EGRESS_SHIM_LOG"
case "$*" in *"$EGRESS_SHIM_REJECT"*) echo "REJECT $(basename "$0") $*" >> "$EGRESS_SHIM_LOG"; echo "$(basename "$0"): simulated failure" >&2; exit 4 ;; esac
exec "$EGRESS_SHIM_REAL" "$@"
SHIMEOF
  chmod 755 "$SHIM/$1"; }
adversarial() {
  echo "== adversarial items: Router stopped (verified), stand-in container on $NET, external observer $OBSERVER =="
  router_stopped || { echo "cannot establish that $ROUTER is stopped (a successful query must say Running=false): refusing to remove the policy" >&2; exit 64; }
  cp "$ENV_FILE" /var/tmp/egress-verify-env.bak || { ng V7-17 "cannot back up $ENV_FILE"; return; }
  ADV_ACTIVE=1
  guard_pause && ok V7-17 "guard timer and service stopped (both report inactive)" || { ng V7-17 "guard timer/service could not be stopped or state undetermined"; return; }
  docker rm -f egress-verify-standin >/dev/null 2>&1
  docker run -d --name egress-verify-standin --network "$NET" "$PY_IMAGE" python3 -m http.server 8787 --bind 0.0.0.0 --directory /tmp >/dev/null 2>&1 || { ng V7-17 "cannot start the stand-in container"; return; }
  NS=egress-verify-standin; sleep 2
  local rip c0 c1 r T s0; rip=$(ns_ip)
  matrix; dns_check V7-8s
  echo "-- V7-17 check must reject a weakened policy (sabotage; every setup step is itself checked)"
  "$SCRIPT" check >/dev/null 2>&1 || ng V7-17 "check fails before sabotage"
  sab iptables -t mangle -D SUBETHA-EGRESS -d "$(gateway_ip)/32" -j DROP && { "$SCRIPT" check >/dev/null 2>&1 && ng V7-17 "check accepted a deleted inventory rule" || ok V7-17 "check rejects a deleted inventory rule"; }
  "$SCRIPT" apply >/dev/null || ng V7-17 "apply failed"
  sab iptables -t mangle -I SUBETHA-EGRESS 2 -j RETURN && { "$SCRIPT" check >/dev/null 2>&1 && ng V7-17 "check accepted an early RETURN" || ok V7-17 "check rejects an early RETURN"; }
  "$SCRIPT" apply >/dev/null || ng V7-17 "apply failed"

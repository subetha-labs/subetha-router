  systemctl daemon-reload; systemctl enable egress-host-observer.service egress-boot-capture.service >/dev/null 2>&1
  local xq; xq=$(xobs_seq); case "$xq" in ERR*) ng V7-11 "cannot read the external observer cursor: $xq"; return;; esac
  printf 'prepared=%s\nboot_id=%s\nobserver=%s\nobserver_report=%s\nxsession=%s\nxseq=%s\ndeny_target=%s\nhost_target=%s\n' "$(date +%s)" "$(cat /proc/sys/kernel/random/boot_id)" "$OBSERVER" "$OBSERVER_REPORT" "$XSESSION" "$xq" "http://$OBSERVER/" "http://$gw:$OBS_PORT/" > "$PREP"
  note V7-11 "prepared (capture lifetime ${CAPTURE_SECONDS}s; boot id $(cat /proc/sys/kernel/random/boot_id); external observer $OBSERVER session $XSESSION, cursor seq $xq). Now: sudo reboot; within that lifetime: sudo OBSERVER=... OBSERVER_REPORT=... subetha-egress-verify --post-boot"
}

prep_value() { awk -F= -v k="$1" '$1==k{print $2}' "$PREP"; }
mono_of_message() { # $1 unit, $2 substring -> __MONOTONIC_TIMESTAMP (us) of the first journal message containing it this boot
  journalctl -q -b -u "$1" -o json 2>/dev/null | python3 -c 'import json,sys
pat=sys.argv[1]
for line in sys.stdin:
    try: d=json.loads(line)
    except Exception: continue
    m=d.get("MESSAGE"); m=m if isinstance(m,str) else ""
    if pat in m: print(d.get("__MONOTONIC_TIMESTAMP","")); break' "$2"; }
post_boot() {
  require_observer
  echo "== V7-11 post-boot evidence =="
  [ -r "$PREP" ] || { ng V7-11 "no --reboot-prepare record at $PREP"; return; }
  # boundaries: a new boot, the same observer configuration, the same external observer session
  [ "$(cat /proc/sys/kernel/random/boot_id)" != "$(prep_value boot_id)" ] && ok V7-11 "boot id changed since prepare (a reboot happened)" || ng V7-11 "boot id unchanged since prepare: no reboot"
  [ "$OBSERVER" = "$(prep_value observer)" ] && [ "$OBSERVER_REPORT" = "$(prep_value observer_report)" ] && ok V7-11 "observer configuration matches the prepare record" || ng V7-11 "observer configuration differs from the prepare record"
  [ "$XSESSION" = "$(prep_value xsession)" ] && ok V7-11 "external observer session $XSESSION unchanged since prepare (every report below is bound to it)" || { ng V7-11 "external observer session changed since prepare ($(prep_value xsession) -> $XSESSION): its log does not cover the reboot"; return; }
  local xq0; xq0=$(prep_value xseq)
  # host observer: exactly one invocation since boot, bound to the process answering the report
  HSESSION=$(obs_health "$(hobs_url)") || HSESSION=""
  local hpid hinv0 cinv0; hpid=$(obs_field "$(hobs_url)" pid "$HSESSION"); hinv0=$(unit_prop egress-host-observer.service InvocationID); cinv0=$(unit_prop egress-boot-capture.service InvocationID)
  [ -n "$HSESSION" ] && [ "$(unit_starts egress-host-observer.service)" = 1 ] && [ "$hpid" = "$(unit_prop egress-host-observer.service MainPID)" ] && ok V7-11 "host observer: one invocation since boot, report bound to its MainPID $hpid (session $HSESSION)" || ng V7-11 "host observer continuity not established (starts=$(unit_starts egress-host-observer.service), pid=$hpid, MainPID=$(unit_prop egress-host-observer.service MainPID))"
  [ "$(unit_starts egress-boot-capture.service)" = 1 ] && [ "$(systemctl is-active egress-boot-capture)" = active ] && ok V7-11 "boot capture: one invocation since boot, still running" || ng V7-11 "boot capture not continuous (starts=$(unit_starts egress-boot-capture.service), state=$(systemctl is-active egress-boot-capture))"
  # ordering from structured timestamps: aid units active (after their readiness probes) < rules applied < containers loading
  local cap_us obs_us app_us load_us
  cap_us=$(unit_prop egress-boot-capture.service ActiveEnterTimestampMonotonic); obs_us=$(unit_prop egress-host-observer.service ActiveEnterTimestampMonotonic)
  app_us=$(mono_of_message docker.service "subetha-egress: applied"); load_us=$(mono_of_message docker.service "Loading containers: start")
  isnum "$cap_us" && isnum "$obs_us" && isnum "$app_us" && isnum "$load_us" && [ "$cap_us" -lt "$app_us" ] && [ "$obs_us" -lt "$app_us" ] && ok V7-11 "observers active (monotonic ${cap_us}us, ${obs_us}us) before the rules (${app_us}us)" || ng V7-11 "observer readiness not proven before the rules (cap=$cap_us obs=$obs_us applied=$app_us)"
  isnum "$app_us" && isnum "$load_us" && [ "$app_us" -lt "$load_us" ] && ok V7-11 "rules applied (${app_us}us) before container restore (${load_us}us)" || ng V7-11 "ordering not proven (applied=$app_us loading=$load_us)"
  journalctl -q -b -u egress-boot-capture.service -u egress-host-observer.service -u docker.service -o json > "$EVID/journal-boot.json" 2>/dev/null
  local dstarts; dstarts=$(unit_starts docker.service); [ "$dstarts" = 1 ] && note V7-11 "docker.service started once since boot" || note V7-11 "docker.service started $dstarts times since boot (ExecStartPre ran each time; the probe log covers every restore)"
  local tw=0; while ! "$SCRIPT" check >/dev/null 2>&1 && [ $tw -lt 60 ]; do sleep 2; tw=$((tw+2)); done
  "$SCRIPT" check >/dev/null 2>&1 && ok V7-11 "policy verified after boot (inventory refreshed by the guard within ${tw}s; the gateway lay inside a denied range meanwhile)" || ng V7-11 "policy does not verify 60 s after boot: $("$SCRIPT" check 2>&1 | head -2 | tr '\n' ' ')"
  # the probe's identity is captured while it runs (a verdict with an empty address would be vacuous)
  local pip prun; pip=$(docker inspect subetha-egress-probe --format "{{(index .NetworkSettings.Networks \"$NET\").IPAddress}}" 2>/dev/null); prun=$(docker inspect subetha-egress-probe --format '{{.State.Running}}' 2>/dev/null)
  [ -n "$pip" ] && [ "$prun" = true ] && ok V7-11 "probe identity captured while running: $pip on $NET (Running=true)" || { ng V7-11 "cannot establish the probe's address while running (ip='$pip', running='$prun')"; return; }
  # quiesce the probe (verified), let the observers settle, then evaluate the whole interval
  docker stop subetha-egress-probe >/dev/null 2>&1 || ng V7-11 "docker stop of the probe failed"
  [ "$(docker inspect -f '{{.State.Running}}' subetha-egress-probe 2>/dev/null)" = false ] && ok V7-11 "probe container stopped (inspection confirms Running=false)" || { ng V7-11 "probe not confirmed stopped"; return; }
  obs_settle "$OBSERVER_REPORT" "$XSESSION" >/dev/null || ng V7-11 "external observer did not settle"; obs_settle "$(hobs_url)" "$HSESSION" >/dev/null || ng V7-11 "host observer did not settle"
  local bootep boot; bootep=$(( $(date +%s) - $(cut -d. -f1 /proc/uptime) )); boot=$(TZ=UTC date -d "@$bootep" +%Y-%m-%dT%H:%M:%S)
  docker logs -t subetha-egress-probe > "$EVID/probe.log" 2>&1
  # both prohibited targets (external observer and host observer, as recorded at prepare): first attempt
  # after boot timed out, every attempt timed out (28), none succeeded, no other status (instrument failure)
  local tgt; for tgt in deny host; do
    local first total ok28 succ other; first=$(awk -v b="$boot" -v t="$tgt" '$1 > b && $2==t' "$EVID/probe.log" | head -1)
    total=$(awk -v b="$boot" -v t="$tgt" '$1 > b && $2==t' "$EVID/probe.log" | wc -l); ok28=$(awk -v b="$boot" -v t="$tgt" '$1 > b && $2==t && $3=="28"' "$EVID/probe.log" | wc -l)
    succ=$(awk -v b="$boot" -v t="$tgt" '$1 > b && $2==t && $3=="0"' "$EVID/probe.log" | wc -l); other=$((total - ok28 - succ))
    echo "  boot at $boot UTC; $tgt ($(prep_value ${tgt}_target)): first attempt after boot: $first"
    [ "$total" -ge 1 ] && echo "$first" | grep -q ' 28 ' && [ "$succ" = 0 ] && [ "$other" = 0 ] && ok V7-11 "$tgt target: $total attempts since boot, first and all timed out (dropped), 0 succeeded, 0 other statuses" || ng V7-11 "$tgt target: attempts=$total timed-out=$ok28 succeeded=$succ other=$other first='$first'"
  done
  [ "$(awk -v b="$boot" '$1 > b && $2=="pub" && $3=="0"' "$EVID/probe.log" | wc -l)" -gt 0 ] && ok V7-11 "probe reached the public control after boot (it was alive)" || ng V7-11 "probe never reached the public control"
  # one coordinated final report per observer: accepts since the cursor, backlog and seq_last together;
  # the control cursors below are taken from these same reports, so nothing can slip between them
  local xq1 hq1
  zero_accepts V7-11 "external observer since the prepare cursor (seq $xq0) through the quiesced probe" "$OBSERVER_REPORT" "$xq0" "$XSESSION"; xq1=$ZA_SEQ
  zero_accepts V7-11 "host observer since boot" "$(hobs_url)" 0 "$HSESSION"; hq1=$ZA_SEQ
  local ctl; ctl=$(conntrack -L 2>/dev/null) || { ng V7-11 "conntrack -L failed"; ctl=""; }
  [ -n "$pip" ] && [ "$(printf '%s\n' "$ctl" | grep "src=$pip " | grep -c -E "dport=(${OBSERVER#*:}|$OBS_PORT) ")" = 0 ] && ok V7-11 "no conntrack entries now for the probe's ($pip) prohibited flows (a delivered or forwarded attempt would have left a confirmed entry; this is a snapshot, the capture and observers cover the interval)" || ng V7-11 "conntrack entries exist for the probe's prohibited flows, or no probe identity"
  # positive controls through the still-running capture and both observers (the probe is stopped, so all traffic after t0 is ours)
  local t0; t0=$(now)
  isnum "$xq1" && isnum "$hq1" || { ng V7-11 "control cursors could not be taken from the final reports (external '$xq1', host '$hq1')"; return; }
  curl -s -o /dev/null -m 3 -H 'X-Control: host' "http://$OBSERVER/"; curl -s -o /dev/null -m 3 -H 'X-Control: host' "http://127.0.0.1:$OBS_PORT/"; sleep 2
  cp -f /var/tmp/boot-capture.pcap "$EVID/boot-capture.pcap" || { ng V7-11 "cannot copy the boot capture"; return; }
  local pc="$EVID/boot-capture.pcap" probe_port=${OBSERVER#*:} syn_before syn_after
  [ -s "$pc" ] && tcpdump -nn -r "$pc" >/dev/null 2>&1 || { ng V7-11 "boot capture unreadable"; return; }
  syn_before=$(tcpdump -nn -tt -r "$pc" "tcp dst port $probe_port and tcp[tcpflags] & tcp-syn != 0 and tcp[tcpflags] & tcp-ack == 0" 2>/dev/null | awk -v t="$t0" '$1 < t' | wc -l)
  syn_after=$(tcpdump -nn -tt -r "$pc" "tcp dst port $probe_port and tcp[tcpflags] & tcp-syn != 0 and tcp[tcpflags] & tcp-ack == 0" 2>/dev/null | awk -v t="$t0" '$1 >= t' | wc -l)
  [ "$syn_before" = 0 ] && ok V7-11 "boot capture: 0 SYNs to the probe port on $UPLINK from boot until the probe was quiesced (nothing escaped during or after restore)" || ng V7-11 "boot capture: $syn_before SYNs to the probe port before the control"
  obs_settle "$OBSERVER_REPORT" "$XSESSION" >/dev/null; local xv1 hv1; xv1=$(obs_verdict "$OBSERVER_REPORT" "$xq1" "$XSESSION" X-Control); hv1=$(obs_verdict "$(hobs_url)" "$hq1" "$HSESSION" X-Control)
  [ "$syn_after" = 1 ] && [ "$(vf "$xv1" accepts)" = 1 ] && [ "$(vf "$xv1" marked)" -ge 1 ] && ok V7-11 "positive control correlated: exactly 1 SYN after t0 on the capture, exactly 1 accept at the external observer since the final-report cursor, carrying X-Control" || ng V7-11 "positive control not correlated (SYNs after t0=$syn_after, external: $xv1)"
  [ "$(vf "$hv1" accepts)" = 1 ] && [ "$(vf "$hv1" marked)" -ge 1 ] && ok V7-11 "host observer recorded exactly its control connection since the final-report cursor" || ng V7-11 "host observer control not recorded as expected ($hv1)"
  # identities at the end: nothing restarted while the verdicts above were taken
  [ "$(unit_prop egress-host-observer.service InvocationID)" = "$hinv0" ] && [ "$(unit_prop egress-boot-capture.service InvocationID)" = "$cinv0" ] && [ "$(obs_health "$OBSERVER_REPORT")" = "$XSESSION" ] && [ "$(obs_health "$(hobs_url)")" = "$HSESSION" ] && ok V7-11 "identities unchanged at the end (aid unit invocations, both observer sessions)" || ng V7-11 "an aid unit or observer changed identity during the evaluation"
  obs_save "$OBSERVER_REPORT" external-postboot; obs_save "$(hobs_url)" host-postboot
}

reboot_cleanup() {
  local bad=0 names req st rc u
  names=$(docker ps -a --format '{{.Names}}') || { ng V7-11 "cannot list containers"; bad=1; }
  printf '%s\n' "$names" | grep -qx subetha-egress-probe && { docker rm -f subetha-egress-probe >/dev/null 2>&1 || { ng V7-11 "cannot remove the probe container"; bad=1; }; }
  # drop the test-only Requires= first and reload; only then may the aid units be stopped
  rm -f /etc/systemd/system/docker.service.d/99-egress-verify.conf "$PREP" || bad=1
  systemctl daemon-reload || { ng V7-11 "daemon-reload failed; aid units left running to avoid stopping docker.service"; return; }
  req=$(systemctl show docker.service -p Requires --value) || { ng V7-11 "cannot read docker.service's Requires; aid units left running"; return; }
  printf '%s\n' "$req" | grep -q egress && { ng V7-11 "docker.service still requires the aid units after reload; aid units left running"; return; }
  systemctl disable --now egress-host-observer.service egress-boot-capture.service >/dev/null 2>&1 || bad=1
  rm -f /etc/systemd/system/egress-host-observer.service /etc/systemd/system/egress-boot-capture.service || bad=1; systemctl daemon-reload || bad=1
  for u in egress-host-observer.service egress-boot-capture.service; do st=$(systemctl is-active "$u" 2>/dev/null); rc=$?; case "$rc:$st" in 3:inactive|4:*) ;; *) ng V7-11 "$u is '$st' (exit $rc) after cleanup"; bad=1 ;; esac; done
  names=$(docker ps -a --format '{{.Names}}') || bad=1; printf '%s\n' "$names" | grep -qx subetha-egress-probe && { ng V7-11 "probe container still present"; bad=1; }
  [ "$(systemctl is-active docker.service)" = active ] || { ng V7-11 "docker.service is not active after cleanup"; bad=1; }
  "$SCRIPT" check >/dev/null 2>&1 || { ng V7-11 "policy does not verify after cleanup"; bad=1; }
  [ "$bad" = 0 ] && ok V7-11 "cleanup verified by fresh queries: probe absent, test dependency gone, aid units inactive, docker active, policy verified" || ng V7-11 "cleanup incomplete; inspect the host"
}

bind_observer() { [ -n "$OBSERVER" ] || return 0   # optional in standard mode; when set it must be bound
  [ -n "$OBSERVER_REPORT" ] || { echo "OBSERVER is set but OBSERVER_REPORT is not" >&2; exit 64; }
  XSESSION=$(obs_health "$OBSERVER_REPORT") && [ -n "$XSESSION" ] || { echo "external observer at $OBSERVER_REPORT is not reachable from the host or not listening (/health)" >&2; exit 69; }; }
case "$MODE" in
  standard)       bind_observer; preconditions; matrix; host_addresses; controls; atomicity ;;
  adversarial)    require_observer; adversarial ;;
  fail-closed)    fail_closed ;;
  reboot-prepare) reboot_prepare ;;
  post-boot)      post_boot ;;
  reboot-cleanup) reboot_cleanup ;;
esac
true

  local ct; ct=$(printf '%s\n' "$ctl" | grep "src=$(ns_ip) " | grep -c -E "$MATRIX_RE")
  [ "${ct:-0}" -eq 0 ] && ok V6-1 "no conntrack entries for the new dropped flows (unconfirmed entries are discarded on drop)" || ng V6-1 "$ct conntrack entries exist for matrix destinations"
}

# ---------------------------------------------------------------- host addresses, loopback
host_addresses() {
  echo "== V6-2 host addresses =="
  hobs_start || { ng V6-2 "host observer not ready"; return; }
  local s0; s0=$(hobs_seq)
  for a in $(host_addrs4) $(env_value HOST_ADDRS4 | tr ' ' '\n' | grep -v '^none$'); do
    case "$a" in 127.*) continue ;; esac
    local c0 c1 r; c0=$(cnt "$a"); [ -z "$c0" ] && { ng V6-2 "$a has no inventory line in the chain"; continue; }
    r=$(curlx "http://$a:$OBS_PORT/" 2); c1=$(cnt "$a")
    [ "${r%% *}" = 28 ] && [ "$c1" -gt "$c0" ] && ok V6-2 "$a firewall-dropped (inventory +$((c1-c0)))" || ng V6-2 "$a: curl '$r', counter $c0->$c1"
  done
  [ "$(hobs_accepts "$s0")" = 0 ] && ok V6-2 "host observer accepted 0 connections during the host-address probes (since seq $s0)" || ng V6-2 "host observer accepted $(hobs_accepts "$s0") connections"
  local s1; s1=$(hobs_seq); curl -s -m 2 -o /dev/null -H 'X-Control: host' "http://127.0.0.1:$OBS_PORT/"
  [ "$(hobs_lines "$s1" X-Control)" -ge 1 ] && ok V6-2 "host observer records a control connection (it was working)" || ng V6-2 "host observer did not record the control connection"
  local tok pub; tok=$(curl -s -m 2 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token 2>/dev/null)
  if [ -n "$tok" ]; then
    pub=$(curl -s -m 2 -H "X-aws-ec2-metadata-token: $tok" http://169.254.169.254/latest/meta-data/public-ipv4 2>/dev/null)
    if [ -n "$pub" ]; then echo " $(env_value HOST_ADDRS4) " | grep -q " $pub " && ok V6-2 "public IPv4 $pub is in HOST_ADDRS4" || ng V6-2 "public IPv4 $pub is NOT in HOST_ADDRS4 (hairpin via the gateway stays open)"
    else note V6-2 "instance has no public IPv4"; fi
  else note V6-2 "IMDS not reachable from the host (not EC2, or endpoint disabled): the public address must be listed in HOST_ADDRS4 by hand"; fi
  obs_save "$(hobs_url)" host-addresses; hobs_stop
  local h; h=$(curlx "$HEALTH_URL" 3)
  [ "${h#* }" = 200 ] && ok V6-16 "loopback $HEALTH_URL from inside the namespace: 200 (namespace-local; A's scope)" || note V6-16 "loopback from inside the namespace: '$h' (HEALTH_URL=$HEALTH_URL)"
}

# ---------------------------------------------------------------- controls, DNS
controls() {
  echo "== V6-7 controls =="
  local h r; h=$(curl -s -o /dev/null -m 3 -w '%{http_code}' "$HEALTH_URL")
  [ "$h" = 200 ] && ok V6-7 "host -> Router $HEALTH_URL: 200 (the path Caddy uses as its upstream)" || ng V6-7 "host -> Router $HEALTH_URL: $h"
  local c0 c1; c0=$(cnt_reply); curl -s -o /dev/null -m 3 "$HEALTH_URL"; c1=$(cnt_reply)
  [ "$c1" -gt "$c0" ] && ok V6-7 "reply-direction exemption counted (+$((c1-c0)))" || ng V6-7 "reply exemption line did not count"
  r=$(curlx "https://example.com/" 6); [ "${r%% *}" = 0 ] && ok V6-7 "namespace -> public HTTPS: ${r#* }" || ng V6-7 "namespace -> public HTTPS: '$r'"
  dns_check V6-8
}
dns_check() { # $1 item id; the uncached-name DNS test against the current namespace
  echo "== $1 DNS =="
  local V r; V=$(veth_of "$NS") || { ng "$1" "cannot find the veth of $NS"; return; }
  capture_start "$V" "port 53" /var/tmp/ev-dns.pcap || { ng "$1" "DNS capture not ready"; return; }
  local name="v$(date +%s%N | cut -c1-13).1.1.1.1.nip.io"
  r=$(probe "curl -s -o /dev/null -m 5 -w '%{exitcode} %{remote_ip}' http://$name/")
  capture_stop /var/tmp/ev-dns.pcap
  local d; d=$(pkts /var/tmp/ev-dns.pcap); isnum "$d" || { ng "$1" "DNS capture unreadable"; return; }
  [ "${r#* }" = 1.1.1.1 ] && ok "$1" "uncached name $name resolved to 1.1.1.1" || ng "$1" "uncached name resolution: '$r'"
  [ "$d" = 0 ] && ok "$1" "0 DNS packets on the veth: the embedded resolver forwards from the host namespace on this Docker version" || ng "$1" "DNS packets on the veth: $d (override present, or a Docker version that forwards from the container namespace)"
  for up in $( (awk '/^nameserver/{print $2}' /run/systemd/resolve/resolv.conf 2>/dev/null; awk '/^nameserver/{print $2}' /etc/resolv.conf) | grep -v '^127\.' | sort -u); do
    local line; line=$(deny_line_of "$up")
    if [ -n "$line" ]; then local c0 c1; c0=$(cnt "$line"); r=$(curlx "http://$up:53/" 2); c1=$(cnt "$line")
      [ "${r%% *}" = 28 ] && [ "$c1" -gt "$c0" ] && ok "$1" "HTTP to upstream resolver $up:53 firewall-dropped (curl 28, $line +$((c1-c0)))" || ng "$1" "HTTP to $up:53: curl '$r', counter $c0->$c1"
    else note "$1" "upstream resolver $up is a public address: HTTP to it is permitted by the policy (not a prohibited destination)"; fi
  done
}

# ---------------------------------------------------------------- atomicity, IPv6
atomicity() {
  echo "== V6-10 reapply atomicity =="
  if command -v strace >/dev/null 2>&1; then
    local n; n=$(strace -f -e trace=sendmsg -o "$EVID/strace-restore.txt" sh -c "$SCRIPT render 4 | iptables-restore --noflush" 2>/dev/null; grep -c 'sendmsg(' "$EVID/strace-restore.txt")
    [ "$n" -eq 1 ] && ok V6-10 "one IPv4 chain restore = 1 netlink sendmsg (single batch; jump placement is a separate step)" || ng V6-10 "restore issued $n sendmsg calls"
  else ng V6-10 "strace not installed: the single-batch property is not measured on this host"; fi
  hobs_start || { ng V6-10 "host observer not ready"; return; }
  local gw c0 c1 s0; gw=$(gateway_ip)
  hammer() { docker run --rm --name egress-verify-hammer --network "container:$NS" --entrypoint sh "$PROBE_IMAGE" -c "echo start \$(date +%s); for i in \$(seq 1 200); do curl -s -o /dev/null -m 0.5 http://$gw:$OBS_PORT/ & done; wait; echo end \$(date +%s)"; }
  c0=$(cnt "$gw"); hammer > "$EVID/hammer-sanity.txt" 2>&1; c1=$(cnt "$gw")
  [ "$c1" -ge $((c0+100)) ] && ok V6-10 "hammer sanity: 200 concurrent SYNs raised the inventory counter by $((c1-c0))" || ng V6-10 "hammer sanity: counter only +$((c1-c0))"
  s0=$(hobs_seq); ( sleep 0.3; hammer > "$EVID/hammer-reapply.txt" 2>&1 ) & local hp=$!
  local l0 l1; l0=$(date +%s); for i in $(seq 1 20); do "$SCRIPT" apply >/dev/null || ng V6-10 "apply failed during the reapply loop"; done; l1=$(date +%s)
  wait $hp; local hx=$?; sleep 1
  local hs he; hs=$(awk '/^start/{print $2}' "$EVID/hammer-reapply.txt"); he=$(awk '/^end/{print $2}' "$EVID/hammer-reapply.txt")
  isnum "$hs" && isnum "$he" && [ "$hx" = 0 ] && [ "$hs" -le "$l1" ] && [ "$he" -ge "$l0" ] && ok V6-10 "hammer ran (exit 0) during the reapply loop (hammer $hs-$he, loop $l0-$l1)" || ng V6-10 "hammer did not overlap the reapply loop (exit $hx, hammer '$hs'-'$he', loop $l0-$l1)"
  [ "$(hobs_accepts "$s0")" = 0 ] && ok V6-10 "200 concurrent SYNs during 20 reapplies: 0 connections accepted by the host observer" || ng V6-10 "$(hobs_accepts "$s0") connections accepted during reapply"
  obs_save "$(hobs_url)" atomicity; hobs_stop
  echo "== V6-14 IPv6 =="
  local d; d=$(docker exec "$NS" cat /proc/sys/net/ipv6/conf/eth0/disable_ipv6 2>/dev/null)
  [ "$d" = 1 ] && ok V6-14 "IPv6 disabled inside the namespace (disable_ipv6=1): no IPv6 traffic can originate" || ng V6-14 "IPv6 enabled inside the namespace (disable_ipv6=$d): IPv6 enforcement is not covered by this runner"
  [ "$(ip6tables -t mangle -S SUBETHA-EGRESS 2>/dev/null | grep -c -- '-j DROP')" -ge 16 ] && ok V6-14 "ip6tables chain has $(ip6tables -t mangle -S SUBETHA-EGRESS | grep -c -- '-j DROP') DROP rules (installed, not exercised)" || ng V6-14 "ip6tables chain incomplete"
  local r; r=$(alp "wget -q -T 2 -O /dev/null 'http://[fe80::1%eth0]:$OBS_PORT/' 2>&1 | head -1")
  echo "$r" | grep -qi 'unreachable\|bad address\|can.t connect' && ok V6-14 "link-local IPv6 attempt kernel-rejected ($r)" || ng V6-14 "link-local IPv6 attempt: '$r'"
}

# ---------------------------------------------------------------- adversarial (Router stopped, stand-in on its network)

  t0=$(now); r=$(curlx "http://$A:$OBS_PORT/" 2)
  [ "${r%% *}" = 0 ] && [ "$(hobs_accepts "$t0")" -ge 1 ] && ok V5-3 "alias $A without its inventory rule: reachable (http ${r#* }, observer accepted) -- the gap an unlisted host address opens" || ng V5-3 "alias $A without its inventory rule: '$r' accepts=$(hobs_accepts "$t0")"
  "$SCRIPT" apply >/dev/null; sleep 0.5; c0=$(cnt "$A"); t0=$(now); r=$(curlx "http://$A:$OBS_PORT/" 2); c1=$(cnt "$A")
  [ "${r%% *}" = 28 ] && [ "$c1" -gt "$c0" ] && [ "$(hobs_accepts "$t0")" = 0 ] && ok V5-3 "alias $A after apply: firewall-dropped (+$((c1-c0)), 0 accepts)" || ng V5-3 "alias $A after apply: '$r' $c0->$c1 accepts=$(hobs_accepts "$t0")"
  docker rm -f egress-verify-target >/dev/null 2>&1
  docker run -d --name egress-verify-target --network "$NET" -p "$A:18000:8000" "$PY_IMAGE" python3 -m http.server 8000 --bind 0.0.0.0 --directory /tmp >/dev/null 2>&1; sleep 2
  T=$(docker inspect egress-verify-target --format "{{(index .NetworkSettings.Networks \"$NET\").IPAddress}}")
  r=$(curlx "http://$A:18000/" 2); [ "${r%% *}" = 28 ] && ok V5-4 "same-bridge hairpin $A:18000 (docker-proxy, host-destined) firewall-dropped by the inventory" || ng V5-4 "hairpin $A:18000: '$r'"

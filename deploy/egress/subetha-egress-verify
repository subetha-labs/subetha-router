  r=$(curlx "http://$T:8000/" 2)
  if [ "$nf" = 1 ]; then [ "${r%% *}" = 28 ] && ok V6-6 "same-bridge neighbor $T firewall-dropped (bridge-nf-call-iptables=1)" || ng V6-6 "same-bridge neighbor $T: '$r' with bridge-nf-call-iptables=1"
  else [ "${r#* }" = 200 ] && ok V6-6 "same-bridge neighbor $T REACHABLE (bridge-nf-call-iptables=$nf): L2-bridged traffic bypasses the rules, which is why the singleton topology is mandatory" || ng V6-6 "same-bridge neighbor $T: '$r' (bridge-nf-call-iptables=$nf)"; fi
  docker rm -f egress-verify-target >/dev/null 2>&1
  docker run -d --name egress-verify-target "$PY_IMAGE" python3 -m http.server 8000 --bind 0.0.0.0 --directory /tmp >/dev/null 2>&1; sleep 2
  T=$(docker inspect egress-verify-target --format '{{(index .NetworkSettings.Networks "bridge").IPAddress}}')
  local raw0 raw1; rawcnt() { iptables -t raw -L PREROUTING -n -v -x 2>/dev/null | awk -v n="$1" '$9==n {s+=$1} END{print s+0}'; }
  c0=$(cnt '172.16.0.0/12'); raw0=$(rawcnt "$T"); r=$(curlx "http://$T:8000/" 2); c1=$(cnt '172.16.0.0/12'); raw1=$(rawcnt "$T")
  if [ "${r%% *}" = 28 ] && [ "$c1" -gt "$c0" ]; then ok V6-6 "docker0 neighbor $T firewall-dropped by our chain (+$((c1-c0)))"
  elif [ "${r%% *}" = 28 ] && [ "$raw1" -gt "$raw0" ]; then ok V6-6 "docker0 neighbor $T dropped by Docker's own raw PREROUTING rule (+$((raw1-raw0))) before our chain: not delivered, but not our evidence"
  else ng V6-6 "docker0 neighbor $T: '$r' (ours +$((c1-c0)), docker raw +$((raw1-raw0)))"; fi
  docker rm -f egress-verify-target >/dev/null 2>&1
  ip addr del $A/32 dev "$UPLINK" 2>/dev/null; "$SCRIPT" apply >/dev/null
  echo "-- V6-9 pre-existing flow to the host observer (allowed while the policy is removed, cut by apply)"
  FORCE=1 "$SCRIPT" remove; docker rm -f egress-verify-stream >/dev/null 2>&1; sleep 0.5; s0=$(hobs_seq)
  docker run -d --name egress-verify-stream --network "container:$NS" "$ALPINE_IMAGE" sh -c "i=0; while true; do i=\$((i+1)); echo tick \$i; sleep 1; done | nc $(gateway_ip) $OBS_PORT" >/dev/null 2>&1
  sleep 3.5; local before after s1; before=$(hobs_lines "$s0" tick); "$SCRIPT" apply >/dev/null; s1=$(hobs_seq); sleep 4; after=$(hobs_lines "$s1" tick)
  local ctl ct; ctl=$(conntrack -L 2>/dev/null) || ctl=""; ct=$(printf '%s\n' "$ctl" | grep "src=$rip " | grep -c "dport=$OBS_PORT ")
  docker rm -f egress-verify-stream >/dev/null 2>&1
  [ "$before" -ge 2 ] && [ "$after" = 0 ] && ok V6-9 "existing flow: $before ticks arrived before apply, 0 after (conntrack entry still present: $ct) -- ORIGINAL-direction packets are dropped" || ng V6-9 "existing flow: ticks before=$before after=$after"
  obs_save "$(hobs_url)" adversarial; hobs_stop
  echo "-- V6-13 guard recovery (best effort; the policy is absent until the timer fires)"
  guard_resume; iptables -t mangle -F SUBETHA-EGRESS; local tg; tg=$(date +%s)
  while ! "$SCRIPT" check >/dev/null 2>&1; do sleep 2; [ $(( $(date +%s) - tg )) -gt 90 ] && break; done
  "$SCRIPT" check >/dev/null 2>&1 && ok V6-13 "guard restored the full policy $(( $(date +%s) - tg )) s after a flush (recovery, not a bound)" || { ng V6-13 "guard did not restore within 90 s"; "$SCRIPT" apply >/dev/null; }
  docker rm -f egress-verify-standin >/dev/null 2>&1; NS=$ROUTER; ADV_ACTIVE=0; rm -f /var/tmp/egress-verify-env.bak
  "$SCRIPT" check >/dev/null 2>&1 && ok V6-17 "final policy check after cleanup" || ng V6-17 "policy does not verify after cleanup"
}
dnat_path() { # $1 hook, $2 target ip:port, $3 counter line, $4 seq fn, $5 accept-count fn, $6 alias port
  local hook=$1 target=$2 line=$3 seqfn=$4 countfn=$5 port=$6 c0 c1 r s0
  [ -n "$line" ] || { ng V6-5 "$hook path: target $target is not inside a denied range; choose an RFC1918 observer"; return; }
  sab iptables -t nat -I PREROUTING 1 -i "$BRIDGE" -d $A/32 -p tcp --dport "$port" -j DNAT --to-destination "$target" || return
  iptables -t mangle -D SUBETHA-EGRESS -d $A/32 -j DROP 2>/dev/null
  c0=$(cnt "$line"); s0=$($seqfn); r=$(curlx "http://$A:$port/" 2); c1=$(cnt "$line")
  [ "${r%% *}" = 28 ] && [ "$c1" -gt "$c0" ] && [ "$($countfn "$s0")" = 0 ] && ok V6-5 "DNAT $A:$port -> $target: post-DNAT destination firewall-dropped in $hook (+$((c1-c0)) on $line, 0 accepts at the target)" || ng V6-5 "$hook path with re-check: '$r' $c0->$c1 accepts=$($countfn "$s0")"
  iptables -t mangle -D "$hook" -i "$BRIDGE" -j SUBETHA-EGRESS
  s0=$($seqfn); r=$(curlx "http://$A:$port/" 3)
  [ "${r%% *}" = 0 ] && [ "$($countfn "$s0")" -ge 1 ] && ok V6-5 "positive control: without the $hook jump the translated connection reaches $target (http ${r#* }, $($countfn "$s0") accept recorded at the target)" || ng V6-5 "positive control on $hook: '$r' accepts=$($countfn "$s0")"
  iptables -t nat -D PREROUTING -i "$BRIDGE" -d $A/32 -p tcp --dport "$port" -j DNAT --to-destination "$target"
  "$SCRIPT" apply >/dev/null || ng V6-5 "apply failed after the $hook DNAT test"
}

fail_closed() {
  echo "== V6-12 fail-closed (stops Docker; observed through the restart retries in the journal) =="
  cp "$ENV_FILE" /var/tmp/egress-verify-env.bak
  systemctl stop docker.socket docker.service
  local t0; t0=$(date -u +%Y-%m-%dT%H:%M:%S)
  printf 'IFACES="%s"\nHOST_ADDRS4="not-an-address"\n' "$(env_value IFACES)" > "$ENV_FILE"
  systemctl start docker.service >/dev/null 2>&1; sleep 20
  local jl attempts; jl=$(TZ=UTC journalctl -q -S "$t0" -u docker.service -o cat); printf '%s\n' "$jl" > "$EVID/journal-failclosed-1.txt"
  attempts=$(printf '%s\n' "$jl" | grep -c "subetha-egress: not an IPv4 address/CIDR: 'not-an-address'")
  [ "$(pgrep -c dockerd)" -eq 0 ] && [ "$(pgrep -c containerd-shim)" -eq 0 ] && [ "$attempts" -ge 2 ] && ok V6-12 "bad HOST_ADDRS4: 0 dockerd and 0 container shims after 20 s; $attempts start attempts each failed in the policy with the expected diagnostic" || ng V6-12 "dockerd=$(pgrep -c dockerd) shims=$(pgrep -c containerd-shim) diagnostic attempts=$attempts"
  printf 'TYPO_KEY=1\n' >> "$ENV_FILE"; systemctl reset-failed docker.service; t0=$(date -u +%Y-%m-%dT%H:%M:%S); systemctl start docker.service >/dev/null 2>&1; sleep 10
  jl=$(TZ=UTC journalctl -q -S "$t0" -u docker.service -o cat); printf '%s\n' "$jl" > "$EVID/journal-failclosed-2.txt"
  [ "$(pgrep -c dockerd)" -eq 0 ] && printf '%s\n' "$jl" | grep -q "unknown key 'TYPO_KEY'" && ok V6-12 "unknown key: docker.service failed with the expected diagnostic (unknown key 'TYPO_KEY')" || ng V6-12 "unknown key: dockerd=$(pgrep -c dockerd), diagnostic present: $(printf '%s\n' "$jl" | grep -c 'unknown key')"
  cp /var/tmp/egress-verify-env.bak "$ENV_FILE"; rm -f /var/tmp/egress-verify-env.bak; systemctl reset-failed docker.service; systemctl start docker.service; sleep 8
  docker start "$ROUTER" >/dev/null 2>&1   # a production Router restores itself (--restart unless-stopped)
  "$SCRIPT" guard >/dev/null 2>&1          # refresh the inventory (bridge addresses appear after dockerd starts)
  "$SCRIPT" check >/dev/null 2>&1 && [ "$(docker inspect "$ROUTER" --format '{{.State.Running}}' 2>/dev/null)" = true ] && ok V6-12 "restored: docker up, policy verified, $ROUTER running" || ng V6-12 "restore failed: check Docker and $ROUTER"
}

reboot_prepare() {
  require_observer
  echo "== V6-11 prepare: probe container, boot-ordered observers, test-only docker dependency, observer cursor =="
  docker rm -f subetha-egress-probe >/dev/null 2>&1
  docker run -d --name subetha-egress-probe --restart unless-stopped --network "$NET" --entrypoint sh "$PROBE_IMAGE" -c "while true; do for t in \"deny http://$OBSERVER/\" \"host http://$(gateway_ip):$OBS_PORT/\" \"pub http://1.1.1.1/\"; do set -- \$t; r=\$(curl -s -o /dev/null -m 1 -w \"%{exitcode} %{http_code}\" \$2 2>/dev/null); echo \"\$1 \$r\"; done; sleep 0.2; done" >/dev/null
  local filter="dst host ${OBSERVER%%:*}"
  sed "s|@UPLINK@|$UPLINK|; s|@FILTER@|$filter|; s|@SECONDS@|$CAPTURE_SECONDS|" "$UNIT_DIR/egress-boot-capture.service" > /etc/systemd/system/egress-boot-capture.service
  sed "s|@UNIT_DIR@|$UNIT_DIR|; s|@PORT@|$OBS_PORT|; s|@REPORT@|$OBS_REPORT|" "$UNIT_DIR/egress-host-observer.service" > /etc/systemd/system/egress-host-observer.service
  mkdir -p /etc/systemd/system/docker.service.d; cp "$UNIT_DIR/99-egress-verify.conf" /etc/systemd/system/docker.service.d/
  rm -f /var/tmp/host-observer.log /var/tmp/boot-capture.pcap /var/tmp/boot-capture.log
  systemctl daemon-reload; systemctl enable egress-host-observer.service egress-boot-capture.service >/dev/null 2>&1
  local xs xq; xs=$(obs_field "$OBSERVER_REPORT" session); xq=$(xobs_seq)
  printf 'prepared=%s\nxsession=%s\nxseq=%s\nobserver=%s\n' "$(date +%s)" "$xs" "$xq" "$OBSERVER" > "$PREP"
  note V6-11 "prepared (capture lifetime ${CAPTURE_SECONDS}s; external observer $OBSERVER session $xs, cursor seq $xq). Now: sudo reboot; within that lifetime: sudo OBSERVER=... OBSERVER_REPORT=... subetha-egress-verify --post-boot"
}

post_boot() {
  require_observer
  echo "== V6-11 post-boot evidence =="
  [ -r "$PREP" ] || { ng V6-11 "no --reboot-prepare record at $PREP"; return; }
  local xs0 xq0; xs0=$(awk -F= '$1=="xsession"{print $2}' "$PREP"); xq0=$(awk -F= '$1=="xseq"{print $2}' "$PREP")
  local j; j=$(TZ=UTC journalctl -q -b -o short-precise -u egress-boot-capture.service -u egress-host-observer.service -u docker.service 2>/dev/null | sed -E 's/^[A-Za-z]{3} [0-9]{2} //'); printf '%s\n' "$j" > "$EVID/journal-boot.txt"
  j=$(printf '%s\n' "$j" | grep -E 'Started egress|Starting docker|subetha-egress: applied|Loading containers: start|Started docker' | head -6); echo "$j" | sed 's/^/  /'
  local tc to ta tl; tc=$(echo "$j" | grep 'Started egress-boot' | awk '{print $1}'); to=$(echo "$j" | grep 'Started egress-host' | awk '{print $1}')
  ta=$(echo "$j" | grep 'applied' | awk '{print $1}'); tl=$(echo "$j" | grep 'Loading containers' | awk '{print $1}')
  [ -n "$tc" ] && [ -n "$to" ] && [ -n "$ta" ] && [ "$tc" \< "$ta" ] && [ "$to" \< "$ta" ] && ok V6-11 "observers ready ($tc, $to) before the rules ($ta)" || ng V6-11 "observer readiness not proven before the rules"
  [ -n "$ta" ] && [ -n "$tl" ] && [ "$ta" \< "$tl" ] && ok V6-11 "rules applied ($ta) before container restore ($tl)" || ng V6-11 "ordering not proven from the journal"
  [ "$(systemctl is-active egress-boot-capture)" = active ] && ok V6-11 "boot capture still running (lifetime not exceeded)" || ng V6-11 "boot capture is not running ($(TZ=UTC journalctl -q -b -u egress-boot-capture.service -o cat | grep -m1 -i 'exited\|denied\|error')): the window is not covered"
  # continuity: the capture must have run once, uninterrupted, since before docker; docker restarts are reported
  local cstarts dstarts; cstarts=$(TZ=UTC journalctl -q -b -u egress-boot-capture.service -o cat | grep -c '^Started '); dstarts=$(TZ=UTC journalctl -q -b -u docker.service -o cat | grep -c '^Started docker')
  [ "$cstarts" = 1 ] && [ "$(systemctl show egress-boot-capture.service -p NRestarts --value)" = 0 ] && ok V6-11 "boot capture ran continuously (started once, 0 restarts)" || ng V6-11 "boot capture was started $cstarts times (restarts=$(systemctl show egress-boot-capture.service -p NRestarts --value)): a restart truncates the capture; the window is not continuously covered"
  [ "$dstarts" = 1 ] && note V6-11 "docker.service started once since boot" || note V6-11 "docker.service started $dstarts times since boot (ExecStartPre ran each time; the probe log covers every restore)"
  # observer continuity: external session unchanged since prepare; host observer not restarted since boot, both listening
  local xs; xs=$(obs_field "$OBSERVER_REPORT" session)
  [ "$xs" = "$xs0" ] && [ "$(obs_field "$OBSERVER_REPORT" listening)" = True ] && ok V6-11 "external observer ran continuously (session $xs unchanged since prepare, listening)" || ng V6-11 "external observer session changed or not listening (prepare $xs0, now $xs)"
  [ "$(obs_field "$(hobs_url)" listening)" = True ] && [ "$(systemctl show egress-host-observer.service -p NRestarts --value)" = 0 ] && ok V6-11 "host observer listening since boot with 0 restarts" || ng V6-11 "host observer not listening or restarted (NRestarts=$(systemctl show egress-host-observer.service -p NRestarts --value))"
  local tw=0; while ! "$SCRIPT" check >/dev/null 2>&1 && [ $tw -lt 60 ]; do sleep 2; tw=$((tw+2)); done
  "$SCRIPT" check >/dev/null 2>&1 && ok V6-11 "policy verified after boot (inventory refreshed by the guard within ${tw}s; the gateway lay inside a denied range meanwhile)" || ng V6-11 "policy does not verify 60 s after boot: $("$SCRIPT" check 2>&1 | head -2 | tr '\n' ' ')"
  # quiesce the probe, then evaluate the whole interval from boot to now
  docker stop subetha-egress-probe >/dev/null 2>&1; sleep 2
  local bootep boot; bootep=$(( $(date +%s) - $(cut -d. -f1 /proc/uptime) )); boot=$(TZ=UTC date -d "@$bootep" +%Y-%m-%dT%H:%M:%S)
  docker logs -t subetha-egress-probe > "$EVID/probe.log" 2>&1
  local first; first=$(awk -v b="$boot" '$1 > b && $2=="deny"' "$EVID/probe.log" | head -1)
  echo "  boot at $boot UTC; first probe attempt after boot: $first"
  echo "$first" | grep -q ' 28 ' && ok V6-11 "first restored attempt to the external observer timed out (dropped)" || ng V6-11 "first restored attempt: '$first'"
  local n; n=$(awk -v b="$boot" '$1 > b && $2=="deny" && $3=="0"' "$EVID/probe.log" | wc -l)
  [ "$n" -eq 0 ] && ok V6-11 "0 successful prohibited attempts since boot" || ng V6-11 "$n successful prohibited attempts since boot"
  [ "$(awk -v b="$boot" '$1 > b && $2=="pub" && $3=="0"' "$EVID/probe.log" | wc -l)" -gt 0 ] && ok V6-11 "probe reached the public control after boot (it was alive)" || ng V6-11 "probe never reached the public control"
  local xa ha xb; xa=$(xobs_accepts "$xq0"); ha=$(hobs_accepts 0); xb=$(obs_field "$OBSERVER_REPORT" backlog)
  [ "$xa" = 0 ] && ok V6-11 "external observer accepted 0 connections since the prepare cursor (seq $xq0) through the quiesced probe" || ng V6-11 "external observer accepted $xa connections since prepare"
  [ "$ha" = 0 ] && ok V6-11 "host observer accepted 0 connections since boot" || ng V6-11 "host observer accepted $ha connections since boot"
  case "$xb" in 0) ok V6-11 "external observer backlog 0 (no connection waiting unaccepted)" ;; null) note V6-11 "external observer cannot report its backlog (no ss); accept counts are userspace counts" ;; *) ng V6-11 "external observer backlog $xb" ;; esac
  # positive controls through the still-running capture and both observers (the probe is stopped, so all traffic after t0 is ours)
  local t0 xq1 hq1; t0=$(now); xq1=$(xobs_seq); hq1=$(hobs_seq)
  curl -s -o /dev/null -m 3 -H 'X-Control: host' "http://$OBSERVER/"; curl -s -o /dev/null -m 3 -H 'X-Control: host' "http://127.0.0.1:$OBS_PORT/"; sleep 2
  # The capture keeps running (-U writes each packet at once): analyse a copy. Stopping the unit here
  # would stop docker.service through the test-only Requires= and relaunch both, truncating the file.
  cp -f /var/tmp/boot-capture.pcap "$EVID/boot-capture.pcap" || { ng V6-11 "cannot copy the boot capture"; return; }
  local pc="$EVID/boot-capture.pcap" probe_port=${OBSERVER#*:} syn_before syn_after
  [ -s "$pc" ] && tcpdump -nn -r "$pc" >/dev/null 2>&1 || { ng V6-11 "boot capture unreadable"; return; }
  syn_before=$(tcpdump -nn -tt -r "$pc" "tcp dst port $probe_port and tcp[tcpflags] & tcp-syn != 0 and tcp[tcpflags] & tcp-ack == 0" 2>/dev/null | awk -v t="$t0" '$1 < t' | wc -l)
  syn_after=$(tcpdump -nn -tt -r "$pc" "tcp dst port $probe_port and tcp[tcpflags] & tcp-syn != 0 and tcp[tcpflags] & tcp-ack == 0" 2>/dev/null | awk -v t="$t0" '$1 >= t' | wc -l)
  [ "$syn_before" = 0 ] && ok V6-11 "boot capture: 0 SYNs to the probe port on $UPLINK from boot until the probe was quiesced (nothing escaped during or after restore)" || ng V6-11 "boot capture: $syn_before SYNs to the probe port before the control"
  local xa1 xl1; xa1=$(xobs_accepts "$xq1"); xl1=$(xobs_lines "$xq1" X-Control)
  [ "$syn_after" = 1 ] && [ "$xa1" = 1 ] && [ "$xl1" -ge 1 ] && ok V6-11 "positive control correlated: exactly 1 SYN after t0 on the capture, exactly 1 accept at the external observer carrying X-Control" || ng V6-11 "positive control not correlated (SYNs after t0=$syn_after, observer accepts=$xa1, control lines=$xl1)"
  [ "$(hobs_accepts "$hq1")" = 1 ] && [ "$(hobs_lines "$hq1" X-Control)" -ge 1 ] && ok V6-11 "host observer recorded exactly its control connection" || ng V6-11 "host observer control not recorded as expected"
  obs_save "$OBSERVER_REPORT" external-postboot; obs_save "$(hobs_url)" host-postboot
}

reboot_cleanup() {
  docker rm -f subetha-egress-probe >/dev/null 2>&1
  # drop the test-only Requires= first (and reload), otherwise stopping the aid units stops docker.service
  rm -f /etc/systemd/system/docker.service.d/99-egress-verify.conf "$PREP"; systemctl daemon-reload
  systemctl disable --now egress-host-observer.service egress-boot-capture.service >/dev/null 2>&1
  rm -f /etc/systemd/system/egress-host-observer.service /etc/systemd/system/egress-boot-capture.service; systemctl daemon-reload
  "$SCRIPT" check >/dev/null 2>&1 && ok V6-11 "policy verified after cleanup" || ng V6-11 "policy does not verify after cleanup"
  note V6-11 "probe container, observers and the test-only docker dependency removed"
}

case "$MODE" in
  standard)       preconditions; matrix; host_addresses; controls; atomicity ;;
  adversarial)    require_observer; adversarial ;;
  fail-closed)    fail_closed ;;
  reboot-prepare) reboot_prepare ;;
  post-boot)      post_boot ;;
  reboot-cleanup) reboot_cleanup ;;
esac
echo "== summary: $pass passed, $fail failed, $info notes; evidence: $EVID =="
[ "$fail" -eq 0 ]

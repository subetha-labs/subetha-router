dnat_path() { # $1 hook, $2 target ip:port, $3 counter line, $4 report url, $5 session, $6 alias port
  local hook=$1 target=$2 line=$3 url=$4 ses=$5 port=$6 c0 c1 r s0 vd
  [ -n "$line" ] || { ng V7-5 "$hook path: target $target is not inside a denied range; choose an RFC1918 observer"; return; }
  sab iptables -t nat -I PREROUTING 1 -i "$BRIDGE" -d $A/32 -p tcp --dport "$port" -j DNAT --to-destination "$target" || return
  iptables -t mangle -D SUBETHA-EGRESS -d $A/32 -j DROP 2>/dev/null
  c0=$(cnt "$line"); s0=$(obs_field "$url" seq_last "$ses"); r=$(curlx "http://$A:$port/" 2); c1=$(cnt "$line")
  [ "${r%% *}" = 28 ] && [ "$c1" -gt "$c0" ] && ok V7-5 "DNAT $A:$port -> $target: post-DNAT destination firewall-dropped in $hook (curl 28, +$((c1-c0)) on $line)" || ng V7-5 "$hook path with re-check: '$r' $c0->$c1"
  obs_settle "$url" "$ses" >/dev/null; zero_accepts V7-5 "target observer for the $hook DNAT probe" "$url" "$s0" "$ses"
  iptables -t mangle -D "$hook" -i "$BRIDGE" -j SUBETHA-EGRESS
  s0=$(obs_field "$url" seq_last "$ses"); r=$(curlx "http://$A:$port/" 3); sleep 0.5; vd=$(obs_verdict "$url" "$s0" "$ses")
  [ "${r%% *}" = 0 ] && [ "$(vf "$vd" accepts)" -ge 1 ] && ok V7-5 "positive control: without the $hook jump the translated connection reaches $target (http ${r#* }, $(vf "$vd" accepts) accept recorded at the target)" || ng V7-5 "positive control on $hook: '$r' $vd"
  iptables -t nat -D PREROUTING -i "$BRIDGE" -d $A/32 -p tcp --dport "$port" -j DNAT --to-destination "$target"
  "$SCRIPT" apply >/dev/null || ng V7-5 "apply failed after the $hook DNAT test"
}

fail_closed() {
  echo "== V7-12 fail-closed (stops Docker; observed through the restart retries in the journal) =="
  cp "$ENV_FILE" /var/tmp/egress-verify-env.bak || { ng V7-12 "cannot back up $ENV_FILE"; return; }

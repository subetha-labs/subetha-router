  docker rm -f subetha-egress-probe >/dev/null 2>&1
  # the probe targets the external observer (uplink path) and the host observer (INPUT path) and a public control
  docker run -d --name subetha-egress-probe --restart unless-stopped --network "$NET" --entrypoint sh "$PROBE_IMAGE" -c "while true; do for t in \"deny http://$OBSERVER/\" \"host http://$(gateway_ip):$OBS_PORT/\" \"pub http://1.1.1.1/\"; do set -- \$t; r=\$(curl -s -o /dev/null -m 1 -w \"%{exitcode} %{http_code}\" \$2 2>/dev/null); echo \"\$1 \$r\"; done; sleep 0.2; done" >/dev/null
  # capture everything to the external observer's address: probe packets arrive there masqueraded to the host
  # address, so attribution is by destination port (the probe port vs the control marker), not by source
  local filter="dst host ${OBSERVER%%:*}"
  sed "s|@UPLINK@|$UPLINK|; s|@FILTER@|$filter|; s|@SECONDS@|$CAPTURE_SECONDS|" "$UNIT_DIR/egress-boot-capture.service" > /etc/systemd/system/egress-boot-capture.service
  sed "s|@UNIT_DIR@|$UNIT_DIR|; s|@PORT@|$OBS_PORT|; s|@REPORT@|$OBS_REPORT|" "$UNIT_DIR/egress-host-observer.service" > /etc/systemd/system/egress-host-observer.service
  mkdir -p /etc/systemd/system/docker.service.d; cp "$UNIT_DIR/99-egress-verify.conf" /etc/systemd/system/docker.service.d/
  rm -f /var/tmp/host-observer.log /var/tmp/boot-capture.pcap /var/tmp/boot-capture.log
  systemctl daemon-reload; systemctl enable egress-host-observer.service egress-boot-capture.service >/dev/null 2>&1
  date +%s > /var/tmp/egress-verify-prepared
  note V5-11 "prepared (capture lifetime ${CAPTURE_SECONDS}s; external observer $OBSERVER). Now: sudo reboot; within that lifetime: sudo OBSERVER=... OBSERVER_REPORT=... subetha-egress-verify --post-boot"
}

post_boot() {
  require_observer
  echo "== V5-11 post-boot evidence =="
  local j; j=$(TZ=UTC journalctl -q -b -o short-precise -u egress-boot-capture.service -u egress-host-observer.service -u docker.service 2>/dev/null | sed -E 's/^[A-Za-z]{3} [0-9]{2} //' | grep -E 'Started egress|Starting docker|subetha-egress: applied|Loading containers: start|Started docker' | head -6)
  echo "$j" | sed 's/^/  /'
  local tc to ta tl; tc=$(echo "$j" | grep 'Started egress-boot' | awk '{print $1}'); to=$(echo "$j" | grep 'Started egress-host' | awk '{print $1}')
  ta=$(echo "$j" | grep 'applied' | awk '{print $1}'); tl=$(echo "$j" | grep 'Loading containers' | awk '{print $1}')
  [ -n "$tc" ] && [ -n "$to" ] && [ -n "$ta" ] && [ "$tc" \< "$ta" ] && [ "$to" \< "$ta" ] && ok V5-11 "observers ready ($tc, $to) before the rules ($ta)" || ng V5-11 "observer readiness not proven before the rules"
  [ -n "$ta" ] && [ -n "$tl" ] && [ "$ta" \< "$tl" ] && ok V5-11 "rules applied ($ta) before container restore ($tl)" || ng V5-11 "ordering not proven from the journal"
  [ "$(systemctl is-active egress-boot-capture)" = active ] && ok V5-11 "boot capture still running (lifetime not exceeded)" || { ng V5-11 "boot capture is not running ($(TZ=UTC journalctl -q -b -u egress-boot-capture.service -o cat | grep -m1 -i 'exited\|denied\|error')): the window is not covered"; }
  local boot bootep; bootep=$(( $(date +%s) - $(cut -d. -f1 /proc/uptime) )); boot=$(TZ=UTC date -d "@$bootep" +%Y-%m-%dT%H:%M:%S)
  local tw=0; while ! "$SCRIPT" check >/dev/null 2>&1 && [ $tw -lt 60 ]; do sleep 2; tw=$((tw+2)); done
  "$SCRIPT" check >/dev/null 2>&1 && ok V5-11 "policy verified after boot (inventory refreshed by the guard within ${tw}s; the gateway was inside a denied range meanwhile)" || ng V5-11 "policy does not verify 60 s after boot: $("$SCRIPT" check 2>&1 | head -2 | tr '\n' ' ')"
  local first; first=$(docker logs -t subetha-egress-probe 2>&1 | awk -v b="$boot" '$1 > b && $2=="deny"' | head -1)
  echo "  boot at $boot UTC; first probe attempt after boot: $first"
  echo "$first" | grep -q ' 28 ' && ok V5-11 "first restored attempt to the external observer timed out (dropped)" || ng V5-11 "first restored attempt: '$first'"
  # the observers are the gate: no accept at the external observer and none at the host observer since boot
  local xa ha; xa=$(xobs_accepts "$bootep"); ha=$(obs_count "127.0.0.1:$OBS_REPORT" "$bootep" "" accept)
  [ "$xa" = 0 ] && ok V5-11 "external observer accepted 0 connections since boot" || ng V5-11 "external observer accepted $xa connections since boot"
  [ "$ha" = 0 ] && ok V5-11 "host observer accepted 0 connections since boot" || ng V5-11 "host observer accepted $ha connections since boot"
  [ "$(docker logs -t subetha-egress-probe 2>&1 | awk -v b="$boot" '$1 > b && $2=="pub" && $3=="0"' | wc -l)" -gt 0 ] && ok V5-11 "probe reached the public control after boot (it was alive)" || ng V5-11 "probe never reached the public control"
  # positive controls through the still-running capture and both observers, then stop the capture
  local t0; t0=$(date +%s)
  curl -s -o /dev/null -m 3 -H 'X-Control: host' "http://$OBSERVER/"; curl -s -o /dev/null -m 3 -H 'X-Control: host' "http://127.0.0.1:$OBS_PORT/"; sleep 2
  systemctl stop egress-boot-capture 2>/dev/null; sleep 1
  local probe_port=${OBSERVER#*:} capt ctrl
  capt=$(pkts /var/tmp/boot-capture.pcap "tcp dst port $probe_port and tcp[tcpflags] & tcp-syn != 0 and tcp[tcpflags] & tcp-ack == 0")
  isnum "$capt" || { ng V5-11 "boot capture unreadable"; return; }
  ctrl=$(xobs_lines "$t0" X-Control)
  [ "$ctrl" -ge 1 ] && [ "$capt" -ge 1 ] && ok V5-11 "positive control: the host's own connection to $OBSERVER was captured on $UPLINK ($capt SYN) and recorded by the observer" || ng V5-11 "positive control failed (captured SYNs=$capt, observer control lines=$ctrl)"
  # every SYN to the probe port before the control is a leak (the probe is the only sender to that port)
  # epoch timestamps (-tt) so the comparison does not depend on the host's timezone
  local leak; leak=$(tcpdump -nn -tt -r /var/tmp/boot-capture.pcap "tcp dst port $probe_port and tcp[tcpflags] & tcp-syn != 0 and tcp[tcpflags] & tcp-ack == 0" 2>/dev/null | awk -v t="$t0" '$1 < t' | wc -l)
  [ "$leak" = 0 ] && ok V5-11 "boot capture: 0 SYNs to the probe port on $UPLINK before the control (nothing escaped during or after restore)" || ng V5-11 "boot capture: $leak SYNs to the probe port before the control"
  [ "$(hobs_lines "$t0" X-Control)" -ge 1 ] && ok V5-11 "host observer recorded its control connection" || ng V5-11 "host observer did not record the control"
}

reboot_cleanup() {
  docker rm -f subetha-egress-probe >/dev/null 2>&1
  rm -f /etc/systemd/system/docker.service.d/99-egress-verify.conf
  systemctl disable --now egress-host-observer.service egress-boot-capture.service >/dev/null 2>&1
  rm -f /etc/systemd/system/egress-host-observer.service /etc/systemd/system/egress-boot-capture.service; systemctl daemon-reload
  "$SCRIPT" check >/dev/null 2>&1 && ok V5-11 "policy verified after cleanup" || ng V5-11 "policy does not verify after cleanup"
  note V5-11 "probe container, observers and the test-only docker dependency removed"
}

case "$MODE" in
  standard)       preconditions; matrix; host_addresses; controls; atomicity ;;
  adversarial)    require_observer; adversarial ;;
  fail-closed)    fail_closed ;;
  reboot-prepare) reboot_prepare ;;
  post-boot)      post_boot ;;
  reboot-cleanup) reboot_cleanup ;;
esac
echo "== summary: $pass passed, $fail failed, $info notes =="
[ "$fail" -eq 0 ]

  [ "$probe_pkts" = 0 ] && [ "$other_pkts" -ge 1 ] && ok V6-1 "uplink $UPLINK: 0 probe packets to deny ranges; $other_pkts host-originated packets to those ranges prove the capture was live" || ng V6-1 "uplink $UPLINK: probe packets=$probe_pkts, other=$other_pkts (a live capture must see some host traffic to those ranges)"

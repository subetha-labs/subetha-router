  systemctl start docker.service >/dev/null 2>&1; sleep 20
  local jl attempts; jl=$(TZ=UTC journalctl -q -S "$t0" -u docker.service -o cat); printf '%s\n' "$jl" > "$EVID/journal-failclosed-1.txt"
  attempts=$(printf '%s\n' "$jl" | grep -c "subetha-egress: not an IPv4 address/CIDR: 'not-an-address'")
  [ "$(pgrep -c dockerd)" -eq 0 ] && [ "$(pgrep -c containerd-shim)" -eq 0 ] && [ "$attempts" -ge 2 ] && ok V7-12 "bad HOST_ADDRS4: 0 dockerd and 0 container shims after 20 s; $attempts start attempts each failed in the policy with the expected diagnostic" || ng V7-12 "dockerd=$(pgrep -c dockerd) shims=$(pgrep -c containerd-shim) diagnostic attempts=$attempts"
  printf 'TYPO_KEY=1\n' >> "$ENV_FILE"; systemctl reset-failed docker.service; t0=$(date -u +%Y-%m-%dT%H:%M:%S); systemctl start docker.service >/dev/null 2>&1; sleep 10
  jl=$(TZ=UTC journalctl -q -S "$t0" -u docker.service -o cat); printf '%s\n' "$jl" > "$EVID/journal-failclosed-2.txt"
  [ "$(pgrep -c dockerd)" -eq 0 ] && printf '%s\n' "$jl" | grep -q "unknown key 'TYPO_KEY'" && ok V7-12 "unknown key: docker.service failed with the expected diagnostic (unknown key 'TYPO_KEY')" || ng V7-12 "unknown key: dockerd=$(pgrep -c dockerd), diagnostic present: $(printf '%s\n' "$jl" | grep -c 'unknown key')"
  cp /var/tmp/egress-verify-env.bak "$ENV_FILE" || ng V7-12 "cannot restore $ENV_FILE"; rm -f /var/tmp/egress-verify-env.bak; systemctl reset-failed docker.service; systemctl start docker.service || ng V7-12 "docker did not start after restoring the env"; sleep 8
  docker start "$ROUTER" >/dev/null 2>&1   # a production Router restores itself (--restart unless-stopped)

#!/bin/bash
# subetha-egress-verify: run the acceptance protocol of docs/ssrf-egress-design.md §17 on the
# host and print evidence for every item. Exit status is non-zero if any item fails. Every
# required observation is a gate: instrumentation that fails to start, a setup step that fails,
# or a command whose status cannot be read fails the item. Raw evidence (captures, observer
# reports, journal excerpts, this output) is kept under /var/tmp/egress-verify-<timestamp>/.
#
#   sudo subetha-egress-verify                  non-disruptive items + preconditions (Router running)
#   sudo subetha-egress-verify --adversarial    Router STOPPED (verified): a stand-in container on the
#                                               Router's network takes its place; temporary host alias
#                                               and containers, policy removal/re-apply, sabotage of
#                                               `check` and fault injection, both DNAT paths, guard
#                                               recovery. Requires OBSERVER/OBSERVER_REPORT.
#   sudo subetha-egress-verify --fail-closed    stops Docker, breaks the env file, proves Docker stays
#                                               down through its restart retries (journal), restores.
#   sudo subetha-egress-verify --reboot-prepare installs the probe container and the boot-ordered
#                                               observer units (plus a test-only docker drop-in),
#                                               records the external observer's session and cursor.
#                                               Requires OBSERVER/OBSERVER_REPORT. Then reboot.
#   sudo subetha-egress-verify --post-boot      reads the boot-ordered evidence after the reboot.
#   sudo subetha-egress-verify --reboot-cleanup removes the probe container, observers and the drop-in.
#
# Environment: ROUTER (container, default subetha-router), NET (default subetha-router-net), BRIDGE
# (default subetha0), UPLINK (default: default-route interface), HEALTH_URL (default
# http://127.0.0.1:8787/healthz; must be the same URL inside and outside the container),
# OBSERVER=<rfc1918 ip>:<port> and OBSERVER_REPORT=<ip>:<port>: an external host you control running
# deploy/egress/egress-observer.py (--port / --report-port). The host-side observer is started by
# this runner (standard/adversarial) or by egress-host-observer.service (reboot).
set -u
ROUTER=${ROUTER:-subetha-router}; NET=${NET:-subetha-router-net}; BRIDGE=${BRIDGE:-subetha0}
UPLINK=${UPLINK:-$(ip -4 route show default | awk '{print $5; exit}')}
HEALTH_URL=${HEALTH_URL:-http://127.0.0.1:8787/healthz}
OBSERVER=${OBSERVER:-}; OBSERVER_REPORT=${OBSERVER_REPORT:-}
ENV_FILE=${SUBETHA_EGRESS_ENV:-/etc/subetha-egress.env}
PROBE_IMAGE=${PROBE_IMAGE:-curlimages/curl:latest}; ALPINE_IMAGE=${ALPINE_IMAGE:-alpine:latest}; PY_IMAGE=${PY_IMAGE:-python:3-alpine}
SCRIPT=${SCRIPT:-/usr/local/sbin/subetha-egress}
UNIT_DIR=${UNIT_DIR:-/usr/local/lib/subetha-egress}
OBS_PORT=19998; OBS_REPORT=19997        # host-side observer ports
REGISTRY_DATE=2025-10-09; CAPTURE_SECONDS=${CAPTURE_SECONDS:-900}
PREP=/var/tmp/egress-verify-prepared
MODE=standard
for a in "$@"; do case "$a" in
  --adversarial) MODE=adversarial ;; --fail-closed) MODE=fail-closed ;; --reboot-prepare) MODE=reboot-prepare ;;
  --post-boot) MODE=post-boot ;; --reboot-cleanup) MODE=reboot-cleanup ;;
  *) echo "unknown option $a" >&2; exit 64 ;; esac; done
EVID=/var/tmp/egress-verify-$(date -u +%Y%m%dT%H%M%SZ)-$MODE; mkdir -p "$EVID"
exec > >(tee -a "$EVID/runner.log") 2>&1
echo "== subetha-egress-verify $MODE; evidence in $EVID =="

pass=0; fail=0; info=0
ok()   { pass=$((pass+1)); printf 'PASS %-6s %s\n' "$1" "$2"; }
ng()   { fail=$((fail+1)); printf 'FAIL %-6s %s\n' "$1" "$2"; }
note() { info=$((info+1)); printf 'INFO %-6s %s\n' "$1" "$2"; }
need() { command -v "$1" >/dev/null 2>&1 || { echo "missing tool: $1" >&2; exit 69; }; }
for t in docker iptables ip6tables tcpdump conntrack curl python3 ip awk flock; do need "$t"; done
[ -r "$UNIT_DIR/egress-observer.py" ] || { echo "missing $UNIT_DIR/egress-observer.py" >&2; exit 69; }

# NS is the container whose network namespace the probes join: the Router (standard) or the
# stand-in (adversarial, with the Router stopped).
NS=$ROUTER
probe()  { docker run --rm --network "container:$NS" --entrypoint sh "$PROBE_IMAGE" -c "$1" 2>/dev/null; }
alp()    { docker run --rm --network "container:$NS" "$ALPINE_IMAGE" sh -c "$1" 2>/dev/null; }
curlx()  { probe "curl -s -o /dev/null -m ${2:-2} -w '%{exitcode} %{http_code}' '$1'"; }
veth_of(){ local idx; idx=$(docker exec "$1" cat /sys/class/net/eth0/iflink 2>/dev/null) || return 1
           ip -o link | awk -F': ' -v i="$idx" '$1==i{print $2}' | cut -d@ -f1; }
cnt()    { iptables -t mangle -L SUBETHA-EGRESS -n -v -x 2>/dev/null | awk -v n="${1%/32}" 'NR>2 && $9==n {print $1; exit}'; }
cnt_reply() { iptables -t mangle -L SUBETHA-EGRESS -n -v -x 2>/dev/null | awk 'NR==3 {print $1}'; }
ns_ip()  { docker inspect "$NS" --format "{{(index .NetworkSettings.Networks \"$NET\").IPAddress}}" 2>/dev/null; }
gateway_ip() { docker network inspect "$NET" --format '{{(index .IPAM.Config 0).Gateway}}' 2>/dev/null; }
subnet()  { docker network inspect "$NET" --format '{{(index .IPAM.Config 0).Subnet}}' 2>/dev/null; }
host_addrs4() { ip -4 -o addr show | awk '{print $4}' | cut -d/ -f1 | grep -v '^169\.254\.' | sort -u; }
env_value() { awk -F= -v k="$1" '$1==k{v=$2; gsub(/"/,"",v); print v}' "$ENV_FILE" 2>/dev/null; }
now()    { date +%s.%N; }
isnum()  { [ "$1" -ge 0 ] 2>/dev/null; }
# ---- observers (egress-observer.py): JSON {session, listening, seq_last, backlog, rows[{seq,t,kind,src,sport,data}]}
obs_get() { curl -s -m 5 "http://$1/?since_seq=${2:-0}" 2>/dev/null || echo ERR; }
obs_field() { obs_get "$1" "${3:-0}" | python3 -c 'import json,sys
try: d=json.load(sys.stdin); v=d.get(sys.argv[1]); print("null" if v is None else v)
except Exception: print("ERR")' "$2"; }
obs_count() { # $1 url, $2 since_seq, $3 kind, $4 substring of data (optional)
  obs_get "$1" "$2" | python3 -c 'import json,sys
kind=sys.argv[1]; pat=sys.argv[2]
try: d=json.load(sys.stdin); print(sum(1 for r in d["rows"] if r["kind"]==kind and (not pat or pat in r.get("data",""))))
except Exception: print("ERR")' "$3" "${4:-}"; }
obs_save() { obs_get "$1" 0 > "$EVID/observer-$2.json"; }
hobs_url() { echo "127.0.0.1:$OBS_REPORT"; }
hobs_start() { hobs_stop; : > /var/tmp/egress-verify-hobs.log
  nohup python3 "$UNIT_DIR/egress-observer.py" --port "$OBS_PORT" --report-port "$OBS_REPORT" >> /var/tmp/egress-verify-hobs.log 2>&1 &
  echo $! > /var/tmp/egress-verify-hobs.pid
  for i in $(seq 1 50); do curl -sf -m 1 -o /dev/null "http://$(hobs_url)/health" && return 0; sleep 0.2; done
  echo "host observer did not become ready (/health)" >&2; return 1; }
hobs_stop() { [ -f /var/tmp/egress-verify-hobs.pid ] && { kill "$(cat /var/tmp/egress-verify-hobs.pid)" 2>/dev/null; rm -f /var/tmp/egress-verify-hobs.pid; }; return 0; }
hobs_seq() { obs_field "$(hobs_url)" seq_last; }
hobs_accepts() { obs_count "$(hobs_url)" "$1" accept; }
hobs_lines() { obs_count "$(hobs_url)" "$1" line "${2:-}"; }
xobs_seq() { obs_field "$OBSERVER_REPORT" seq_last; }
xobs_accepts() { obs_count "$OBSERVER_REPORT" "$1" accept; }
xobs_lines() { obs_count "$OBSERVER_REPORT" "$1" line "${2:-}"; }
require_observer() { [ -n "$OBSERVER" ] && [ -n "$OBSERVER_REPORT" ] || { echo "OBSERVER=<rfc1918 ip:port> and OBSERVER_REPORT=<ip:port> (egress-observer.py on a host you control) are required for this mode" >&2; exit 64; }
  curl -sf -m 3 -o /dev/null "http://$OBSERVER_REPORT/health" || { echo "external observer at $OBSERVER_REPORT is not reachable from the host or not listening (/health)" >&2; exit 69; }; }
# ---- captures: readiness is mandatory, unreadable captures are errors
capture_start() { rm -f "$3"; tcpdump -Z root -i "$1" -w "$3" -U "$2" >/dev/null 2>"$3.err" & echo $! > "$3.pid"
  for i in $(seq 1 30); do grep -q 'listening on' "$3.err" 2>/dev/null && return 0; sleep 0.1; done; echo "capture on $1 not ready" >&2; return 1; }
capture_stop() { kill -INT "$(cat "$1.pid")" 2>/dev/null; wait "$(cat "$1.pid")" 2>/dev/null; rm -f "$1.pid"; sleep 1; cp -f "$1" "$EVID/" 2>/dev/null; }
pkts()   { [ -s "$1" ] || { echo ERR; return; }; local o; o=$(tcpdump -nn -r "$1" ${2:+"$2"} 2>/dev/null) || { echo ERR; return; }; printf '%s' "$o" | grep -c .; }
guard_pause()  { systemctl stop subetha-egress-guard.timer subetha-egress-guard.service 2>/dev/null
  [ "$(systemctl is-active subetha-egress-guard.timer)" != active ] && [ "$(systemctl is-active subetha-egress-guard.service)" != active ] && [ "$(systemctl is-active subetha-egress-guard.service)" != activating ]; }
guard_resume() { systemctl start subetha-egress-guard.timer 2>/dev/null; }

DENY_FILTER='(dst net 0.0.0.0/8 or dst net 10.0.0.0/8 or dst net 100.64.0.0/10 or dst net 127.0.0.0/8 or dst net 169.254.0.0/16 or dst net 172.16.0.0/12 or dst net 192.0.0.0/24 or dst net 192.0.2.0/24 or dst net 192.88.99.0/24 or dst net 192.168.0.0/16 or dst net 198.18.0.0/15 or dst net 198.51.100.0/24 or dst net 203.0.113.0/24 or dst net 224.0.0.0/4 or dst net 240.0.0.0/4)'
SRC_FILTER='(src net 0.0.0.0/8 or src net 10.0.0.0/8 or src net 100.64.0.0/10 or src net 127.0.0.0/8 or src net 169.254.0.0/16 or src net 172.16.0.0/12 or src net 192.0.0.0/24 or src net 192.0.2.0/24 or src net 192.88.99.0/24 or src net 192.168.0.0/16 or src net 198.18.0.0/15 or src net 198.51.100.0/24 or src net 203.0.113.0/24 or src net 224.0.0.0/4 or src net 240.0.0.0/4)'
MATRIX_RE='dst=(0\.1\.2\.3|10\.0\.0\.1|100\.64\.0\.1|169\.254\.169\.254|172\.16\.0\.1|192\.0\.0\.1|192\.0\.2\.1|192\.88\.99\.1|192\.168\.0\.1|198\.18\.0\.1|198\.51\.100\.1|203\.0\.113\.1|240\.0\.0\.1) '
DENY_RANGES="0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.0.2.0/24 192.88.99.0/24 192.168.0.0/16 198.18.0.0/15 198.51.100.0/24 203.0.113.0/24 224.0.0.0/4 240.0.0.0/4"
# the deny line (as printed by iptables -L) that contains address or network $1, or empty
deny_line_of() { python3 -c 'import ipaddress,sys
a=sys.argv[1]; ranges=sys.argv[2].split()
try:
    n=ipaddress.ip_network(a, strict=False)
    for r in ranges:
        if n.subnet_of(ipaddress.ip_network(r)): print(r); break
except Exception: pass' "$1" "$DENY_RANGES"; }

# ---------------------------------------------------------------- preconditions / facts (structural parsing)
dockerd_pid() { pidof dockerd | awk '{print $1}'; }
dockerd_cmdline() { tr '\0' ' ' < "/proc/$(dockerd_pid)/cmdline"; }
daemon_json_path() { local f; f=$(dockerd_cmdline 2>/dev/null | grep -o -- '--config-file[= ][^ ]*' | sed 's/--config-file[= ]//'); echo "${f:-/etc/docker/daemon.json}"; }
daemon_cfg() { # prints "<key>=<json value>" for the keys we care about, "absent" if no file, ERR if unreadable/invalid
  python3 -c 'import json,sys,os
p=sys.argv[1]
if not os.path.exists(p): print("absent"); sys.exit(0)
try:
    d=json.load(open(p))
    for k in ("userland-proxy","dns","firewall-backend","live-restore"): print(f"{k}={json.dumps(d.get(k))}")
except Exception as e: print("ERR "+str(e))' "$(daemon_json_path)"; }
preconditions() {
  echo "== preconditions and facts (V6-0 / V6-15) =="
  "$SCRIPT" check >/dev/null 2>&1 && ok V6-0 "policy equals the rendered policy and the first rules of every hook are exactly our jumps (subetha-egress check)" || ng V6-0 "subetha-egress check failed: $("$SCRIPT" check 2>&1 | head -3 | tr '\n' ' ')"
  local running; running=$(docker inspect "$ROUTER" --format '{{.State.Running}}' 2>/dev/null) && [ "$running" = true ] && ok V6-0 "$ROUTER is running" || ng V6-0 "$ROUTER not running or not inspectable"
  local nets mode members
  nets=$(docker inspect "$ROUTER" --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}' 2>/dev/null)
  mode=$(docker inspect "$ROUTER" --format '{{.HostConfig.NetworkMode}}' 2>/dev/null)
  [ "$(echo $nets)" = "$NET" ] && [ "$mode" = "$NET" ] && ok V6-6 "complete attachment set is {$NET} (NetworkMode=$mode)" || ng V6-6 "attachment set '$nets' NetworkMode '$mode' (expected only $NET)"
  members=$(docker network inspect "$NET" --format '{{range .Containers}}{{.Name}} {{end}}' 2>/dev/null)
  [ "$(echo $members)" = "$ROUTER" ] && ok V6-6 "$NET contains only $ROUTER (singleton topology)" || ng V6-6 "$NET members: '$members' (expected only $ROUTER)"
  [ "$(docker network inspect "$NET" --format '{{index .Options "com.docker.network.bridge.name"}}')" = "$BRIDGE" ] && ok V6-0 "bridge name is $BRIDGE" || ng V6-0 "bridge name is not $BRIDGE"
  echo " $(env_value IFACES) " | grep -q " $BRIDGE " && ok V6-0 "IFACES covers $BRIDGE" || ng V6-0 "IFACES '$(env_value IFACES)' does not list $BRIDGE"
  # every IPAM subnet of the Router network must lie inside a denied range (covers the post-boot inventory lag)
  local subs bad=0; subs=$(docker network inspect "$NET" --format '{{range .IPAM.Config}}{{.Subnet}} {{end}}' 2>/dev/null)
  [ -n "$(echo $subs)" ] || { ng V6-0 "$NET has no IPAM subnet"; bad=1; }
  for sn in $subs; do [ -n "$(deny_line_of "$sn")" ] || { ng V6-0 "$NET subnet $sn is not inside a denied range: its gateway would be reachable until the first inventory refresh"; bad=1; }; done
  [ "$bad" = 0 ] && ok V6-0 "every $NET subnet ($(echo $subs)) lies inside a denied range"
  [ "$(docker network inspect "$NET" --format '{{.EnableIPv6}}')" = false ] && ok V6-14 "$NET has IPv6 disabled" || ng V6-14 "$NET has IPv6 enabled: IPv6 enforcement is not covered by this runner"
  [ "$(docker info --format '{{.LiveRestoreEnabled}}')" = false ] && ok V6-15 "LiveRestoreEnabled=false (docker info)" || ng V6-15 "LiveRestoreEnabled=true: containers survive daemon stop; fail-closed does not hold"
  local fb; fb=$(docker info --format '{{.FirewallBackend.Driver}}' 2>/dev/null); [ "$fb" = iptables ] && ok V6-15 "docker firewall backend is iptables" || ng V6-15 "docker firewall backend is '$fb' (only iptables is designed and measured)"
  local fa fx; fa=$(systemctl is-active firewalld 2>/dev/null); fx=$?
  case "$fx:$fa" in 0:*) ng V6-15 "firewalld is $fa (reloads flush mangle; disable it)" ;; 3:inactive|3:failed|4:*) ok V6-15 "firewalld absent or inactive ($fa)" ;; *) ng V6-15 "firewalld state undetermined (exit $fx '$fa')" ;; esac
  local cmd; cmd=$(dockerd_cmdline 2>/dev/null) || { ng V6-15 "cannot read dockerd's command line"; cmd=ERR; }
  local cfg; cfg=$(daemon_cfg)
  case "$cfg" in ERR*) ng V6-15 "daemon config $(daemon_json_path) unreadable or invalid: $cfg" ;;
    absent) note V6-15 "no daemon config file at $(daemon_json_path) (defaults)" ;; esac
  if [ "$cmd" != ERR ] && ! echo "$cmd" | grep -q -- '--userland-proxy=false' && ! echo "$cfg" | grep -q '^userland-proxy=false$'; then ok V6-15 "userland-proxy default (cmdline and config parsed)"; else ng V6-15 "userland-proxy=false or undetermined: hairpin uses DNAT, a path this runner does not validate"; fi
  local esp; esp=$(systemctl show docker.service -p ExecStartPre --value)
  echo "$esp" | grep -q 'argv\[\]=/usr/local/sbin/subetha-egress apply ; ignore_errors=no' && ok V6-15 "docker.service ExecStartPre is exactly '/usr/local/sbin/subetha-egress apply' with ignore_errors=no" || ng V6-15 "docker.service ExecStartPre is not exactly 'subetha-egress apply' (ignore_errors=no): $(echo "$esp" | head -c 200)"
  [ "$(systemctl is-active subetha-egress-guard.timer)" = active ] && ok V6-15 "guard timer active" || ng V6-15 "guard timer not active"
  note V6-15 "kernel $(uname -r); docker $(docker version --format '{{.Server.Version}}') (DNS provenance measured on 28.3.3; V6-8 re-measures here); $(iptables -V); bridge-nf-call-iptables=$(cat /proc/sys/net/bridge/bridge-nf-call-iptables 2>/dev/null || echo absent)"
  note V6-15 "docker raw rules: $(iptables -t raw -S 2>/dev/null | grep -c -- '^-A'); nat DOCKER returns for bridges: $(iptables -t nat -S DOCKER 2>/dev/null | grep -c -- '-j RETURN'); docker mangle rules: $(iptables -t mangle -S 2>/dev/null | grep -v SUBETHA | grep -c -- '^-A')"
  for fam in ipv4 ipv6; do local upd; upd=$(curl -s -m 10 "https://www.iana.org/assignments/iana-$fam-special-registry/iana-$fam-special-registry.xml" | grep -o '<updated>[^<]*</updated>' | head -1 | sed 's/<[^>]*>//g')
    if [ -z "$upd" ]; then ng V6-15 "IANA $fam registry date not fetched: cannot confirm the snapshot is current"; elif [ "$upd" \> "$REGISTRY_DATE" ]; then ng V6-15 "IANA $fam registry updated $upd > snapshot $REGISTRY_DATE: review the deny list"; else ok V6-15 "IANA $fam registry snapshot $REGISTRY_DATE is current ($upd)"; fi; done
  # DNS provenance: no override anywhere (container, daemon config, dockerd command line), embedded resolver in use
  [ "$(docker inspect "$ROUTER" --format '{{len .HostConfig.Dns}}{{len .HostConfig.DnsOptions}}{{len .HostConfig.DnsSearch}}')" = 000 ] && ok V6-8 "$ROUTER has no --dns/--dns-opt/--dns-search override" || ng V6-8 "$ROUTER overrides DNS (HostConfig.Dns*): the embedded resolver would forward from the container namespace"
  if [ "$cmd" != ERR ] && ! echo "$cmd" | grep -q -- '--dns[= ]' && ! echo "$cfg" | grep -q '^dns=\[' ; then ok V6-8 "no daemon dns override (cmdline and config parsed)"; else ng V6-8 "daemon dns override or undetermined: the embedded resolver would forward from the container namespace"; fi
  local resolv; resolv=$(docker exec "$ROUTER" cat /etc/resolv.conf 2>/dev/null | awk '/^nameserver/{print $2; exit}')
  [ "$resolv" = 127.0.0.11 ] && ok V6-8 "container resolver is the embedded DNS (127.0.0.11)" || ng V6-8 "container resolver is $resolv, not the embedded DNS"
  note V6-8 "host nameservers (inherited by the embedded resolver): $(awk '/^nameserver/{print $2}' /etc/resolv.conf | tr '\n' ' ')"
  { echo "cmdline: $cmd"; echo "config: $cfg"; echo "ExecStartPre: $esp"; docker info 2>/dev/null; } > "$EVID/docker-facts.txt"
}

# ---------------------------------------------------------------- matrix
matrix() {
  echo "== V6-1 matrix from the namespace of $NS (TCP; UDP; ICMP; captures both ways) =="
  local V; V=$(veth_of "$NS") || { ng V6-1 "cannot find the veth of $NS"; return; }
  capture_start "$UPLINK" "$DENY_FILTER" /var/tmp/ev-uplink.pcap || { ng V6-1 "uplink capture not ready"; return; }
  capture_start "$V" "(src net $(subnet) and $DENY_FILTER) or (dst net $(subnet) and $SRC_FILTER)" /var/tmp/ev-veth.pcap || { ng V6-1 "veth capture not ready"; capture_stop /var/tmp/ev-uplink.pcap; return; }
  for t in 0.1.2.3:0.0.0.0/8 10.0.0.1:10.0.0.0/8 100.64.0.1:100.64.0.0/10 169.254.169.254:169.254.0.0/16 172.16.0.1:172.16.0.0/12 192.0.0.1:192.0.0.0/24 192.0.2.1:192.0.2.0/24 192.88.99.1:192.88.99.0/24 192.168.0.1:192.168.0.0/16 198.18.0.1:198.18.0.0/15 198.51.100.1:198.51.100.0/24 203.0.113.1:203.0.113.0/24 240.0.0.1:240.0.0.0/4; do
    local ip=${t%%:*} range=${t#*:} c0 c1 r
    c0=$(cnt "$range"); r=$(curlx "http://$ip:80/" 2); c1=$(cnt "$range")
    if [ "${r%% *}" = 28 ] && [ "$c1" -gt "$c0" ]; then ok V6-1 "$ip TCP firewall-dropped (curl 28, $range +$((c1-c0)))"; else ng V6-1 "$ip: curl '$r', counter $c0->$c1"; fi
  done
  local c0 c1 r
  c0=$(cnt '224.0.0.0/4'); r=$(curlx "http://224.0.0.1:80/" 2); c1=$(cnt '224.0.0.0/4')
  [ "${r%% *}" = 7 ] && [ "$c1" -eq "$c0" ] && ok V6-1 "224.0.0.1 TCP kernel-rejected (curl 7, nothing sent)" || ng V6-1 "224.0.0.1 TCP: curl '$r', counter $c0->$c1"
  c0=$(cnt '224.0.0.0/4'); alp "echo x | nc -u -w 1 224.0.0.1 9" >/dev/null; c1=$(cnt '224.0.0.0/4')
  [ "$c1" -gt "$c0" ] && ok V6-1 "224.0.0.1 UDP firewall-dropped (+$((c1-c0)))" || ng V6-1 "224.0.0.1 UDP: counter $c0->$c1"
  c0=$(cnt '127.0.0.0/8'); r=$(curlx "http://127.1.2.3:80/" 2); c1=$(cnt '127.0.0.0/8')
  [ "$c1" -eq "$c0" ] && ok V6-16 "127.1.2.3 namespace-local: never reached the host chain (curl ${r%% *}); A's scope" || ng V6-16 "127.1.2.3 hit the host chain?"
  capture_start "$V" "host 10.0.0.1 and udp" /var/tmp/ev-udp.pcap || ng V6-1 "udp capture not ready"
  c0=$(cnt '10.0.0.0/8'); alp "echo x | nc -u -w 1 10.0.0.1 9" >/dev/null; c1=$(cnt '10.0.0.0/8'); capture_stop /var/tmp/ev-udp.pcap
  local out back; out=$(pkts /var/tmp/ev-udp.pcap "src net $(subnet)"); back=$(pkts /var/tmp/ev-udp.pcap "dst net $(subnet)")
  [ "$c1" -ge $((c0+1)) ] && [ "$out" = 1 ] && [ "$back" = 0 ] && ok V6-1 "UDP to 10.0.0.1:9 firewall-dropped (+$((c1-c0)); 1 datagram out, 0 back)" || ng V6-1 "UDP to 10.0.0.1: counter $c0->$c1, veth out=$out back=$back"
  capture_start "$V" "host 10.0.0.1 and icmp" /var/tmp/ev-icmp.pcap || ng V6-1 "icmp capture not ready"
  c0=$(cnt '10.0.0.0/8'); alp "ping -c 1 -W 1 10.0.0.1 >/dev/null 2>&1" >/dev/null; c1=$(cnt '10.0.0.0/8'); capture_stop /var/tmp/ev-icmp.pcap
  out=$(pkts /var/tmp/ev-icmp.pcap "src net $(subnet)"); back=$(pkts /var/tmp/ev-icmp.pcap "dst net $(subnet)")
  [ "$c1" -ge $((c0+1)) ] && [ "$out" = 1 ] && [ "$back" = 0 ] && ok V6-1 "ICMP echo to 10.0.0.1 firewall-dropped (+$((c1-c0)); 1 request out, 0 replies)" || ng V6-1 "ICMP to 10.0.0.1: counter $c0->$c1, veth out=$out back=$back"
  if [ -n "$OBSERVER" ]; then local s0; s0=$(xobs_seq); r=$(curlx "http://$OBSERVER/" 2)
    [ "${r%% *}" = 28 ] && [ "$(xobs_accepts "$s0")" = 0 ] && ok V6-1 "external observer $OBSERVER firewall-dropped (curl 28, 0 accepts recorded there since seq $s0)" || ng V6-1 "external observer $OBSERVER: curl '$r', accepts=$(xobs_accepts "$s0")"; fi
  local ans; ans=$(alp "nslookup 10.0.0.1.nip.io 2>/dev/null | awk '/^Address/{print \$2}' | grep -v '#' | tail -1")
  c0=$(cnt '10.0.0.0/8'); r=$(curlx "http://10.0.0.1.nip.io/" 3); c1=$(cnt '10.0.0.0/8')
  [ "$ans" = 10.0.0.1 ] && [ "${r%% *}" = 28 ] && [ "$c1" -gt "$c0" ] && ok V6-1 "name resolving to a private address (10.0.0.1.nip.io -> $ans) firewall-dropped (+$((c1-c0)))" || ng V6-1 "DNS-derived private destination: answer '$ans', curl '$r', counter $c0->$c1"
  capture_stop /var/tmp/ev-veth.pcap; capture_stop /var/tmp/ev-uplink.pcap

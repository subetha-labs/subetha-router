  isnum "$a" && isnum "$u" || { ng V6-1 "captures unreadable (veth=$a uplink=$u)"; return; }
  probe_pkts=$(pkts /var/tmp/ev-uplink.pcap "dst port 80 or dst port 9 or icmp or dst port $OBS_PORT${obsport:+ or dst port $obsport}"); other_pkts=$((u - probe_pkts))

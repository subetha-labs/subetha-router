  rm -rf /var/tmp/egress-verify-fakebin; "$SCRIPT" check >/dev/null 2>&1 && ok V5-17 "policy intact after the inventory-failure test" || ng V5-17 "policy not intact after the inventory-failure test"
  echo "-- V5-3 host alias $A (outside every deny range) and V5-4 same-bridge hairpin"

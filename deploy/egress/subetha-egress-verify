  "$SCRIPT" check >/dev/null 2>&1 && [ "$(docker inspect "$ROUTER" --format '{{.State.Running}}' 2>/dev/null)" = true ] && ok V7-12 "restored: docker up, policy verified, $ROUTER running" || ng V7-12 "restore failed: check Docker and $ROUTER"
}

reboot_prepare() {
  require_observer
  echo "== V7-11 prepare: probe container, boot-ordered observers, test-only docker dependency, boot id and observer cursor =="
  local gw; gw=$(gateway_ip) && python3 -c 'import ipaddress,sys; ipaddress.IPv4Address(sys.argv[1])' "$gw" 2>/dev/null || { ng V7-11 "cannot determine a valid IPv4 gateway for $NET (got '$gw')"; return; }
